# Documentation only: protected files are supplied by the runtime owner.
# The application reads process.env; this file is not loaded automatically.
PORT=8080
CORE_DATABASE_URL_FILE=/run/secrets/example-core-database-url
VENDURE_CHANNEL_TOKEN_FILE=/run/secrets/example-vendure-channel-token
BFF_ASSERTION_HMAC_SECRET_FILE=/run/secrets/example-bff-assertion-hmac
COMMERCE_CONTEXT_HMAC_SECRET_FILE=/run/secrets/example-commerce-context-hmac
CART_SESSION_ENCRYPTION_KEY_FILE=/run/secrets/example-cart-session-encryption-key
VENDURE_ADMIN_USERNAME_FILE=/run/secrets/example-vendure-admin-username
VENDURE_ADMIN_PASSWORD_FILE=/run/secrets/example-vendure-admin-password
# These exact internal URLs are enforced by the preserved original code.
VENDURE_SHOP_API_URL=http://crays-member-providers-vendure-1:3000/shop-api
VENDURE_ADMIN_API_URL=http://crays-member-providers-vendure-1:3000/admin-api
CRAYS_ALLOWED_ORIGINS_JSON=["https://preview.example.invalid"]
CCLUB067_DIAGNOSTIC_MODE=false
