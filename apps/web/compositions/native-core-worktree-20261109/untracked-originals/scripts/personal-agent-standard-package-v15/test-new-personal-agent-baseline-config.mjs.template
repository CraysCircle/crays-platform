/** Prepared four pure default-intent tests; no native/runtime/auth proof from these. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash}from'node:crypto';
import{getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create}from'./new-personal-agent-baseline-config.mjs';import{getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as createOld}from'../personal-agent-standard-package-v14/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('V14 all124 obligations and old17tools retained with only offline calculator18th source intent',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.proposal.assignedBindingCapabilityIds,o.proposal.assignedBindingCapabilityIds);assert.equal(x.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(x.proposal.assignedTools,[...o.proposal.assignedTools,'crays_personal_webtools']);assert.deepEqual(std.descriptor.plugins.slice(0,-1),old.descriptor.plugins);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);assert.deepEqual(std.descriptor.capabilityComponentAssignments.slice(0,-1),old.descriptor.capabilityComponentAssignments);assert.equal(std.descriptor.plugins.at(-1).fullCapabilityClosed,false);});
test('all13 prior skills including Subscriptions Pantry correctedBudget preserved with14th conditional own instruction',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.addedSkillAssignments.slice(0,-1),o.addedSkillAssignments);const cfg=x.proposal.nativeConfigFragment,oldcfg=o.proposal.nativeConfigFragment;assert.deepEqual(cfg.agents.entries['agent-one'].skills,[...oldcfg.agents.entries['agent-one'].skills,'crays-personal-webtools']);assert.equal(cfg.agents.entries['agent-one'].skills.length,14);assert(!cfg.tools.allow.includes('crays_personal_webtools'));assert.deepEqual(cfg.plugins,oldcfg.plugins);for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(x.proposal.readiness[k],false);const a=x.proposal.artifactAssignments.at(-1);assert.equal(a.referenceVerifiedByFactory,false);assert.equal(a.nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');});
test('two people isolated and actual public12/native4/browser proofs plus exactRoot skill are references only',()=>{const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);const plugin=std.descriptor.plugins.at(-1);assert.equal(plugin.nativeActorGrantProven,false);assert.equal(plugin.originalNativeCasesQualified,4);for(const[label,r]of Object.entries(plugin.publicQualificationEvidence)){const raw=fs.readFileSync(r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);const e=JSON.parse(raw);if(label==='component'){assert.equal(e.actualChecks.tapTests,12);assert.equal(e.actualChecks.tapPassed,12);assert.equal(e.actualChecks.tapFailed,0);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}else if(label==='originalNative'){assert.equal(e.actualChecks.cases.length,4);assert.equal(e.actualChecks.normalMediaParseAndLoad,true);assert.equal(e.terminal.sameIdentitySuccess,true);assert.equal(e.terminal.onlyOwnLeaseReturned,true);assert.deepEqual(e.bindings.result,plugin.qualificationEvidence.originalNative);}else{assert.equal(e.actualBrowserProof.status,'PASS');assert.equal(e.rootKernelChecks.coherentRendererKernelProof,true);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}}const s=std.descriptor.addedSkillAssignments.at(-1),bytes=fs.readFileSync(s.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),s.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/crays-personal-webtools/SKILL.md',import.meta.url))));assert.equal(s.nativeLoadVerified,false);assert.equal(a.proposal.modelAccountReadiness.canonicalPersonId,'person-one');assert.equal(b.proposal.modelAccountReadiness.canonicalPersonId,'person-two');});
test('__CRAYS_PRIVATE_IDENTIFIER_231b1142ce0b02f8eefa5e45__ account injected credentials wrong package and duplicate missing or wrong new artifact bindings denied',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_231b1142ce0b02f8eefa5e45__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_231b1142ce0b02f8eefa5e45__',x=>x.modelAccount.token='DENIED',x=>x.expectedPackageSha256='0'.repeat(64),x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[x.artifactBindings.length-2]=x.artifactBindings.at(-1)]){const x=input();change(x);assert.throws(()=>create(x));}});
