test('two people retain124 and allV9 components while receiving12 assigned tools/eight skill IDs with separate own account/path intents',()=>{const a=createV10(input()),b=createV10(input(modern,'person-two','agent-two')),v9=createV9(input(old));assert.equal(a.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(a.proposal.assignedBindingCapabilityIds,v9.proposal.assignedBindingCapabilityIds);assert.deepEqual(a.proposal.assignedTools,[...v9.proposal.assignedTools,'crays_chess']);assert.equal(a.proposal.assignedTools.length,12);assert.equal(a.proposal.nativeConfigFragment.agents.entries['agent-one'].skills.length,8);assert.deepEqual(a.proposal.artifactAssignments.slice(0,-1),v9.proposal.artifactAssignments);for(const key of ['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[key],b.proposal.paths[key]);assert.notEqual(a.proposal.personNamespace,b.proposal.personNamespace);pending(a);pending(b);assert(Object.isFrozen(a.proposal));});
test('new descriptor appends onlyChess;124/full previous obligations/Notice/doc0.7/QRcreate stay exact',()=>{for(const k of ['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(modern.descriptor[k],old.descriptor[k]);for(const k of ['plugins','tools','skills','addedSkillAssignments','capabilityComponentAssignments'])assert.deepEqual(modern.descriptor[k].slice(0,-1),old.descriptor[k]);assert.equal(plugin.fullCapabilityClosed,false);assert.equal(plugin.nativeActorGrantProven,false);assert.equal(plugin.componentTenQualified,true);assert.equal(plugin.originalNativeMediaFourQualified,true);for(const proof of Object.values(plugin.qualificationEvidence)){const raw=fs.readFileSync(proof.path);assert.equal(createHash('sha256').update(raw).digest('hex'),proof.sha256);}const doc=modern.descriptor.plugins.find(p=>p.id==='crays-document-exports');assert.equal(doc.version,'0.7.0');assert.deepEqual(doc.availableFormats,['txt','csv','xlsx','pptx','pdf','docx','epub']);assert.deepEqual(modern.descriptor.plugins.find(p=>p.id==='crays-qr').availableActions,['create']);});
test('actualRoot chess manifest38 and instruction bytes match; known installed reference never mints load or readiness',()=>{const root=plugin.artifactRoot+'/'+plugin.knownInstalledManifestSha256,raw=fs.readFileSync(root+'/CRAYS_ARTIFACT_MANIFEST.json');assert.equal(createHash('sha256').update(raw).digest('hex'),plugin.knownInstalledManifestSha256);assert.deepEqual(plugin.files,JSON.parse(raw).files);assert.equal(plugin.files.length,38);const bytes=fs.readFileSync(new URL('./source-skills/crays-chess/SKILL.md',import.meta.url));assert.equal(createHash('sha256').update(bytes).digest('hex'),skill.contentSha256);assert.equal(skill.artifactManifestSha256Reference,'7027ab8a67333d9acabedb140b604eaa46a72d3bb196ef8f53cab92dfd08c710');const sm=fs.readFileSync(skill.proposedArtifactRoot+'/CRAYS_SKILL_ARTIFACT_MANIFEST.json');assert.equal(createHash('sha256').update(sm).digest('hex'),skill.artifactManifestSha256Reference);assert.deepEqual(JSON.parse(sm).files,[{relative:'skills/crays-chess/SKILL.md',bytes:bytes.length,sha256:skill.contentSha256}]);assert(bytes.equals(fs.readFileSync(skill.proposedSkillPath)));assert.equal(skill.nativeLoadVerified,false);assert.equal(skill.runtimeStartAllowed,false);const x=input(),binding=x.artifactBindings.find(b=>b.pluginId===id);Object.assign(binding,{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',manifestSha256:plugin.knownInstalledManifestSha256,admissionReceiptSha256:'a'.repeat(64)});const r=createV10(x),a=r.proposal.artifactAssignments.at(-1);assert.equal(a.proposedLoadPath,root);assert.equal(a.nativeConfigInclusionState,'REFERENCE_ONLY_NOT_RUNTIME_ADMISSION');assert(r.proposal.nativeConfigFragment.tools.allow.includes('crays_chess'));assert(r.proposal.nativeConfigFragment.plugins.allow.includes(id));assert(r.proposal.nativeConfigFragment.plugins.load.paths.includes(root));assert(r.proposal.nativeConfigFragment.skills.load.extraDirs.includes(skill.proposedExtraDir));assert.equal(a.sharedInstructionReferenceVerifiedByFactory,false);const sourceOnly=createV10(input());assert(!sourceOnly.proposal.nativeConfigFragment.tools.allow.includes('crays_chess'));assert.equal(sourceOnly.proposal.artifactAssignments.at(-1).nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');assert.equal(a.referenceVerifiedByFactory,false);pending(r);});
test('__CRAYS_PRIVATE_IDENTIFIER_2ffa1d6bb3c0000db345e786__ account/credentials/wrong artifact/duplicate binding and accessor input denied',()=>{for(const change of [x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_2ffa1d6bb3c0000db345e786__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_2ffa1d6bb3c0000db345e786__',x=>x.modelAccount.token='DENIED',x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.at(-1).manifestSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[0]=structuredClone(x.artifactBindings.at(-1))]){const x=input();change(x);assert.throws(()=>createV10(x));}const x=input();Object.defineProperty(x,'token',{get(){throw Error('ACCESSOR_MUST_NOT_RUN')}});assert.throws(()=>createV10(x),e=>e.message!=='ACCESSOR_MUST_NOT_RUN');});
