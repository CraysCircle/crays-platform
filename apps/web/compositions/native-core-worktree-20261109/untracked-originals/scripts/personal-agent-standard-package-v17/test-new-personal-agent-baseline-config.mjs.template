import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{createHash}from'node:crypto';
import{getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create}from'./new-personal-agent-baseline-config.mjs';import{getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as createOld}from'../personal-agent-standard-package-v16/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('V16 full124 and retained47 obligations exact with only twentieth Packing assignment',()=>{const a=create(input()),b=createOld(input(old));assert.equal(a.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(a.proposal.assignedBindingCapabilityIds,b.proposal.assignedBindingCapabilityIds);assert.deepEqual(a.proposal.assignedTools,[...b.proposal.assignedTools,'crays_packing']);assert.equal(a.proposal.assignedTools.length,20);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);assert.deepEqual(std.descriptor.plugins.slice(0,-1),old.descriptor.plugins);assert.deepEqual(std.descriptor.capabilityComponentAssignments.slice(0,-1),old.descriptor.capabilityComponentAssignments);});
test('sixteenth Packing instruction remains source assigned and grants no runtime tool without admission',()=>{const a=create(input()),b=createOld(input(old)),cfg=a.proposal.nativeConfigFragment,prior=b.proposal.nativeConfigFragment;assert.deepEqual(a.addedSkillAssignments.slice(0,-1),b.addedSkillAssignments);assert.deepEqual(cfg.agents.entries['agent-one'].skills,[...prior.agents.entries['agent-one'].skills,'crays-packing']);assert.equal(cfg.agents.entries['agent-one'].skills.length,16);assert(!cfg.tools.allow.includes('crays_packing'));assert.deepEqual(cfg.plugins,prior.plugins);assert.equal(a.proposal.artifactAssignments.at(-1).nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(a.proposal.readiness[k],false);assert.deepEqual(cfg.cron,prior.cron);});
test('actual public component18 native6 pure5 and Root6 skill2 are references only',()=>{const p=std.descriptor.plugins.at(-1);for(const[label,r]of Object.entries(p.publicQualificationEvidence)){const raw=fs.readFileSync(r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);const e=JSON.parse(raw);if(label==='component'){assert.equal(e.actualComponentProof.tapPassed,18);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}else if(label==='originalNative'){assert.equal(e.actualChecks.cases.length,6);assert.equal(e.actualChecks.operationsCovered.length,13);assert.equal(e.actualChecks.weatherResearchExecuted,false);assert.equal(e.onlyOwnLeaseReturned,true);}else{assert.equal(e.actualChecks.tapPassed,5);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}}const s=std.descriptor.addedSkillAssignments.at(-1),bytes=fs.readFileSync(s.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),s.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/crays-packing/SKILL.md',import.meta.url))));assert.equal(s.nativeLoadVerified,false);assert.equal(p.fullCapabilityClosed,false);});
test('two isolated persons own-login readiness stays pending without credentials or runtime activation',()=>{const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);for(const p of[a,b]){assert.equal(p.proposal.modelAccountReadiness.state,'PENDING_OWN_LOGIN');assert.equal(p.proposal.modelAccountReadiness.readinessReceiptSha256,null);assert.equal(p.proposal.readiness.credentialsInherited,false);assert.equal(p.proposal.readiness.runtimeStartAllowed,false);}});
test('__CRAYS_PRIVATE_IDENTIFIER_5f159876be42c060ae123518__ model owner injected token wrong package and missing duplicate or forged Packing binding denied',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_5f159876be42c060ae123518__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_5f159876be42c060ae123518__',x=>x.modelAccount.token='DENIED',x=>x.expectedPackageSha256='0'.repeat(64),x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[x.artifactBindings.length-2]=x.artifactBindings.at(-1),x=>{x.artifactBindings.at(-1).state='INSTALLATION_ADMISSION_REFERENCE_SUPPLIED';x.artifactBindings.at(-1).manifestSha256='0'.repeat(64);x.artifactBindings.at(-1).admissionReceiptSha256='1'.repeat(64);}]){const a=input();change(a);assert.throws(()=>create(a));}});
