/** Four prepared pure V16 intent cases only; no tests executed during source preparation. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash}from'node:crypto';
import{getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create}from'./new-personal-agent-baseline-config.mjs';import{getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as createOld}from'../personal-agent-standard-package-v15/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('V15 all124 obligations and old18tools retained with only Habits19th source intent',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.proposal.assignedBindingCapabilityIds,o.proposal.assignedBindingCapabilityIds);assert.equal(x.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(x.proposal.assignedTools,[...o.proposal.assignedTools,'crays_habits']);assert.deepEqual(std.descriptor.plugins.slice(0,-1),old.descriptor.plugins);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);assert.deepEqual(std.descriptor.capabilityComponentAssignments.slice(0,-1),old.descriptor.capabilityComponentAssignments);assert.equal(std.descriptor.plugins.at(-1).fullCapabilityClosed,false);assert.equal(std.descriptor.plugins.at(-1).fullOutcomeOwner,'CRAYS-076');});
test('all14 old skills and Webtools Subs Pantry correctedBudget retained with15th conditional instruction',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.addedSkillAssignments.slice(0,-1),o.addedSkillAssignments);const cfg=x.proposal.nativeConfigFragment,prior=o.proposal.nativeConfigFragment;assert.deepEqual(cfg.agents.entries['agent-one'].skills,[...prior.agents.entries['agent-one'].skills,'crays-habits']);assert.equal(cfg.agents.entries['agent-one'].skills.length,15);assert(!cfg.tools.allow.includes('crays_habits'));assert.deepEqual(cfg.plugins,prior.plugins);assert.equal(x.proposal.artifactAssignments.at(-1).nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');assert.deepEqual(cfg.cron,prior.cron);for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(x.proposal.readiness[k],false);});
test('two persons isolated and exact public14/native6/root instruction references grant no own authority',()=>{const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);assert.equal(a.proposal.modelAccountReadiness.canonicalPersonId,'person-one');assert.equal(b.proposal.modelAccountReadiness.canonicalPersonId,'person-two');const p=std.descriptor.plugins.at(-1);assert.equal(p.originalNativeCasesQualified,6);assert.equal(p.nativeActorGrantProven,false);for(const[label,r]of Object.entries(p.publicQualificationEvidence)){const raw=fs.readFileSync(r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);const e=JSON.parse(raw);if(label==='component'){assert.equal(e.actualComponentProof.tapTests,14);assert.equal(e.actualComponentProof.tapPassed,14);assert.equal(e.actualComponentProof.tapFailed,0);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}else{assert.equal(e.actualChecks.cases.length,6);assert.equal(e.actualChecks.operationsCovered.length,10);assert.equal(e.actualChecks.originalRegistryFactoryAndCurrentness,true);assert.equal(e.actualChecks.remindersCronActivated,false);assert.equal(e.terminalSameIdentitySuccessfulExit,true);assert.equal(e.onlyOwnLeaseReturned,true);assert.deepEqual(e.bindings.result,p.qualificationEvidence.originalNative);}}const s=std.descriptor.addedSkillAssignments.at(-1),bytes=fs.readFileSync(s.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),s.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/crays-habits/SKILL.md',import.meta.url))));assert.equal(s.nativeLoadVerified,false);});
test('__CRAYS_PRIVATE_IDENTIFIER_19638b6cd3cd73a1aef20d68__ account injected credentials wrong package and duplicate missing or wrong Habits bindings denied',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_19638b6cd3cd73a1aef20d68__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_19638b6cd3cd73a1aef20d68__',x=>x.modelAccount.token='DENIED',x=>x.expectedPackageSha256='0'.repeat(64),x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[x.artifactBindings.length-2]=x.artifactBindings.at(-1)]){const x=input();change(x);assert.throws(()=>create(x));}});
