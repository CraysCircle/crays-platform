/** Prepared focused V9 proposal tests only. No QR generation/decoding, DB, provider, model, runtime or auth-store access. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';
import {getPersonalAgentStandardPackage as getV9,createNewPersonalAgentStandardConfigWith124 as createV9} from './new-personal-agent-baseline-config.mjs';
import {getPersonalAgentStandardPackage as getV8,createNewPersonalAgentStandardConfigWith124 as createV8} from '../personal-agent-standard-package-v8/new-personal-agent-baseline-config.mjs';
const modern=getV9(),legacy=getV8(),ID='crays-qr',TOOL='crays_qr',manifestSha='5173486fc3058967aafa1b097b7ada6e9c8992fd97ce1d99bb1869b5f373f794',root='/opt/crays/openclaw/plugin-artifacts/crays-qr/'+manifestSha;
const hash=b=>createHash('sha256').update(b).digest('hex'),plugin=modern.descriptor.plugins.find(p=>p.id===ID);
const input=(standard=modern,person='person-one',agent='agent-one')=>({canonicalPersonId:person,agentId:agent,expectedPackageVersion:standard.descriptor.version,expectedPackageSha256:standard.sha256,modelAccount:{canonicalPersonId:person,agentId:agent,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:standard.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
const qrBinding=x=>x.artifactBindings.find(p=>p.pluginId===ID);
function referenced(){const x=input();Object.assign(qrBinding(x),{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',manifestSha256:manifestSha,admissionReceiptSha256:'a'.repeat(64)});return x;}
function pending(result){for(const k of ['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(result.proposal.readiness[k],false);assert.equal(result.proposal.modelAccountReadiness.state,'PENDING_OWN_LOGIN');assert.equal(result.proposal.modelAccountReadiness.referenceVerifiedByFactory,false);}
test('two new people receive same124 unchanged obligations and QR-create intent while private paths and own model account remain separate',()=>{
 const a=createV9(input()),b=createV9(input(modern,'person-two','agent-two')),old=createV8(input(legacy));
 assert.deepEqual(a.proposal.assignedBindingCapabilityIds,old.proposal.assignedBindingCapabilityIds);assert.equal(new Set(a.proposal.assignedBindingCapabilityIds).size,124);assert.deepEqual(b.proposal.assignedBindingCapabilityIds,a.proposal.assignedBindingCapabilityIds);assert.equal(a.proposal.assignedTools.length,11);assert.deepEqual(a.proposal.assignedTools,[...old.proposal.assignedTools,TOOL]);
 assert.deepEqual(modern.descriptor.binding124,legacy.descriptor.binding124);assert.deepEqual(modern.descriptor.additional124SkillAssignments,legacy.descriptor.additional124SkillAssignments);assert.deepEqual(modern.descriptor.skills,legacy.descriptor.skills);assert.equal(modern.descriptor.skills.length,7);
 for(const k of ['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);assert.notEqual(a.proposal.personNamespace,b.proposal.personNamespace);pending(a);pending(b);
 for(const result of [a,b]){assert(!result.proposal.nativeConfigFragment.tools.allow.includes(TOOL));assert(!result.proposal.nativeConfigFragment.plugins.allow.includes(ID));assert.equal(result.proposal.artifactAssignments.find(x=>x.pluginId===ID).proposedLoadPath,null);const hook=result.proposal.hookArtifactAssignments[0];for(const k of ['accountId','recipient','channelId','nativeConfigPatch'])assert.equal(hook[k],null);assert.equal(hook.nativeConfigEnabled,false);}
});
test('exact QR reference proposes only additional QR tool and immutable artifact path; it grants no model or runtime readiness',()=>{
 const a=createV9(input()),b=createV9(referenced()),before=a.proposal.nativeConfigFragment,after=b.proposal.nativeConfigFragment;
 assert.deepEqual(after.tools.allow,[...before.tools.allow,TOOL]);assert.deepEqual(after.agents.entries['agent-one'].tools.allow,[...before.agents.entries['agent-one'].tools.allow,TOOL]);assert.deepEqual(after.plugins.load.paths,[...before.plugins.load.paths,root]);assert.deepEqual(after.plugins.allow,[...before.plugins.allow,ID]);assert.equal(after.plugins.entries[ID].enabled,true);
 const restored=structuredClone(after);restored.tools.allow.pop();restored.agents.entries['agent-one'].tools.allow.pop();restored.plugins.load.paths.pop();restored.plugins.allow.pop();delete restored.plugins.entries[ID];assert.deepEqual(restored,before);
 const assignment=b.proposal.artifactAssignments.find(x=>x.pluginId===ID);assert.equal(assignment.proposedLoadPath,root);assert.equal(assignment.referenceVerifiedByFactory,false);assert.equal(assignment.componentScope,'CREATE_ONLY_FULL_CAP121_OPEN');pending(b);
});
test('descriptor pins actual304-file closure and original native8 component proof while QR reading, native owner delivery and EPUB-reader acceptance remain open',()=>{
 const raw=fs.readFileSync(root+'/CRAYS_ARTIFACT_MANIFEST.json');assert.equal(hash(raw),manifestSha);const actual=JSON.parse(raw);assert.deepEqual(plugin.files,actual.files);assert.equal(plugin.files.length,304);assert.equal(plugin.knownInstalledManifestSha256,manifestSha);assert.equal(plugin.codeSetSha256,'8dc33c5a2ed47adb6970ec312901ed774b83dab4054619b93fc10567e05d3ba3');
 assert.deepEqual(plugin.availableActions,['create']);assert.equal(plugin.readActionImplemented,false);assert.equal(plugin.fullCapabilityClosed,false);assert.equal(plugin.nativeActorGrantProven,false);assert.equal(plugin.actualPlatformSendOrHandsetProven,false);assert.equal(plugin.liveActivationProven,false);
 assert.equal(modern.descriptor.capabilityComponentAssignments.length,2);assert.equal(modern.descriptor.capabilityComponentAssignments[0].fullCapabilityClosed,false);assert(!modern.descriptor.plugins.some(p=>p.id==='crays-epub-export'));assert.deepEqual(modern.descriptor.plugins.filter(p=>![ID,'crays-document-exports'].includes(p.id)),legacy.descriptor.plugins.filter(p=>p.id!=='crays-document-exports'));
 const upgraded=modern.descriptor.plugins.find(p=>p.id==='crays-document-exports');assert.equal(upgraded.version,'0.7.0');assert.deepEqual(upgraded.availableFormats,['txt','csv','xlsx','pptx','pdf','docx','epub']);assert.equal(upgraded.files.length,312);assert.equal(upgraded.epubReaderOpened,false);assert.equal(upgraded.platformSendPerformed,false);
 const proof=fs.readFileSync(new URL('../../docs/architecture/evidence/CRAYS_AGENT_QR_ORIGINAL_NATIVE_FACTORY_AND_MEDIA_2026_10_15.json',import.meta.url));assert.equal(hash(proof),plugin.qualificationEvidence.sha256);assert.equal(JSON.parse(proof).actualEightNativeCasesPassed,true);assert.equal(JSON.parse(proof).authenticatedUserOrBeforeToolCallPolicyProven,false);
});
test('__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__ account, credential injection, wrong QR artifact and malformed bindings are rejected rather than becoming grants',()=>{
 for(const mutate of [x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>x.modelAccount.token='SYNTHETIC_DENIED',x=>x.modelAccount.provider='__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>x.modelAccount.apiRoute='__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>x.workspace='/__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>qrBinding(x).proposedLoadPath='/__CRAYS_PRIVATE_IDENTIFIER_9b012c9b1f08ed14af8938f6__',x=>qrBinding(x).manifestSha256='c2d3ae5cfd7a79197acfcba212f53f2f5ffcfe6d9234e285489fdcf496dc6cd1',x=>qrBinding(x).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[0]=structuredClone(qrBinding(x))]){const x=referenced();mutate(x);assert.throws(()=>createV9(x));}
 const x=input();Object.defineProperty(x,'token',{get(){throw Error('ACCESSOR_MUST_NOT_RUN')}});assert.throws(()=>createV9(x),e=>e.message!=='ACCESSOR_MUST_NOT_RUN');
});
