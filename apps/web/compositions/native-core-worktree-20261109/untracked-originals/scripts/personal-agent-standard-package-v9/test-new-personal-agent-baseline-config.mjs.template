test('actual seven-format Root instruction is pinned and references only propose0.7 without verifying user or native readiness',()=>{
 const x=referenced(),exp=modern.descriptor.plugins.find(p=>p.id==='crays-document-exports'),binding=x.artifactBindings.find(p=>p.pluginId===exp.id);Object.assign(binding,{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',manifestSha256:exp.knownInstalledManifestSha256,admissionReceiptSha256:'b'.repeat(64)});
 const result=createV9(x),skill=modern.descriptor.addedSkillAssignments.find(s=>s.skillId===exp.id),assignment=result.proposal.artifactAssignments.find(s=>s.pluginId===exp.id);
 assert.equal(skill.artifactManifestSha256Reference,'560e34e6b19fb2d55a57e956431659b2e04221d4e759d495415611e2ed379d97');assert.equal(skill.proposedExtraDir,skill.proposedArtifactRoot+'/skills');assert.equal(skill.proposedSkillPath,skill.proposedExtraDir+'/crays-document-exports/SKILL.md');
 assert.equal(hash(fs.readFileSync(skill.proposedArtifactRoot+'/CRAYS_SKILL_ARTIFACT_MANIFEST.json')),skill.artifactManifestSha256Reference);assert.equal(skill.historicalSixFormatInstructionReference.scope,'SIX_FORMAT_ONLY_NOT_RELABELLED_SEVEN');assert.equal(skill.nativeLoadVerified,false);assert.equal(skill.userAcceptanceProven,false);assert.equal(assignment.nativeConfigInclusionState,'REFERENCE_ONLY_NOT_RUNTIME_ADMISSION');assert.equal(assignment.sharedInstructionReferenceVerifiedByFactory,false);
 const cfg=result.proposal.nativeConfigFragment;assert(cfg.tools.allow.includes('crays_document_exports'));assert(cfg.tools.allow.includes('crays_qr'));assert(cfg.skills.load.extraDirs.includes(skill.proposedExtraDir));assert(!cfg.skills.load.extraDirs.includes('/opt/crays/openclaw/skill-artifacts/crays-document-exports/43d3b8b90d3c307849ede5ba59392b62d93cb7623e8562b5eb7afbb00527592d/skills'));assert.equal(cfg.agents.entries['agent-one'].skills.length,7);
 const instruction=fs.readFileSync(skill.proposedSkillPath);assert.equal(hash(instruction),skill.contentSha256);assert(instruction.equals(fs.readFileSync(new URL('./source-skills/crays-document-exports/SKILL.md',import.meta.url))));assert.match(instruction.toString(),/OWN_OR_AUTHORIZED/);assert.match(instruction.toString(),/DRM/);assert.match(instruction.toString(),/EPUB reader is unproven/);pending(result);
 const unbound=createV9(input());assert(!unbound.proposal.nativeConfigFragment.tools.allow.includes('crays_document_exports'));assert.equal(unbound.proposal.artifactAssignments.find(s=>s.pluginId===exp.id).nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');
 const old=referenced(),row=old.artifactBindings.find(p=>p.pluginId===exp.id);Object.assign(row,{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',codeSetSha256:legacy.descriptor.plugins.find(p=>p.id===exp.id).codeSetSha256,manifestSha256:legacy.descriptor.plugins.find(p=>p.id===exp.id).knownInstalledManifestSha256,admissionReceiptSha256:'c'.repeat(64)});assert.throws(()=>createV9(old));
});
