 assert.deepEqual(modern.descriptor.addedSkillAssignments.filter(s=>s.skillId!=='crays-document-exports'),legacy.descriptor.addedSkillAssignments.filter(s=>s.skillId!=='crays-document-exports'));assert.deepEqual(modern.descriptor.hookPlugins,legacy.descriptor.hookPlugins);assert.equal(createV8(input(legacy)).proposal.standardPackage.version,legacy.descriptor.version);assert.equal(createV8(input(legacy)).proposal.assignedTools.length,10);
 const expected={"STANDARD_PACKAGE.json": "7f0d65b71cc134e510f8794e1366e723297f71534ddf0e7e1da1508ecf965f3b", "new-personal-agent-baseline-config.mjs": "a3fd98a7c87dc2360b36d8279e55b6d27845f253d3d9ae29279eb99381912bf5", "test-new-personal-agent-baseline-config.mjs": "e5ced24532c85583bae708841083516114ee9707864968428af952e0ff8d0cf9"};
