const standard=getV11(),old=getV10(),ids=['crays-item-inventory','crays-training-log'];const input=(s=standard,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
