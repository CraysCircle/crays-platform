test('two people receive same124/14tools/10skills with distinct own paths and no new SOURCE_ASSIGNED tools registered',()=>{const x=createV11(input()),y=createV11(input(standard,'person-two','agent-two')),v10=createV10(input(old));assert.equal(x.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(x.proposal.assignedBindingCapabilityIds,v10.proposal.assignedBindingCapabilityIds);assert.deepEqual(x.proposal.artifactAssignments.slice(0,-2),v10.proposal.artifactAssignments);assert.deepEqual(x.proposal.assignedTools,[...v10.proposal.assignedTools,'crays_item_inventory','crays_training_log']);assert.equal(x.proposal.nativeConfigFragment.agents.entries['agent-one'].skills.length,10);for(const k of['stateDir','workspace','agentDir'])assert.notEqual(x.proposal.paths[k],y.proposal.paths[k]);for(const id of ids)assert(!x.proposal.nativeConfigFragment.plugins.allow.includes(id));pending(x);pending(y);});
test('only two components append; V10 contents and all124 obligations remain exact',()=>{for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins','requiredAccountRoute'])assert.deepEqual(standard.descriptor[k],old.descriptor[k]);for(const k of['tools','skills','plugins','addedSkillAssignments','capabilityComponentAssignments'])assert.deepEqual(standard.descriptor[k].slice(0,-2),old.descriptor[k]);for(const p of standard.descriptor.plugins.slice(-2)){assert.equal(p.fullCapabilityClosed,false);assert.equal(p.nativeActorGrantProven,false);for(const r of Object.values(p.qualificationEvidence))assert.equal(createHash('sha256').update(fs.readFileSync(r.path)).digest('hex'),r.sha256);}});
test('actual Root code/skill bytes match and exact admission references register only proposed tools without runtime readiness',()=>{const x=input();for(const id of ids){const p=standard.descriptor.plugins.find(p=>p.id===id),s=standard.descriptor.addedSkillAssignments.find(s=>s.skillId===id),root=p.artifactRoot+'/'+p.knownInstalledManifestSha256,raw=fs.readFileSync(root+'/CRAYS_ARTIFACT_MANIFEST.json');assert.equal(createHash('sha256').update(raw).digest('hex'),p.knownInstalledManifestSha256);assert.deepEqual(JSON.parse(raw).files,p.files);for(const f of p.files)assert.equal(createHash('sha256').update(fs.readFileSync(root+'/'+f.path)).digest('hex'),f.sha256);assert.equal(createHash('sha256').update(fs.readFileSync(s.proposedSkillPath)).digest('hex'),s.contentSha256);assert(fs.readFileSync(new URL('./source-skills/'+id+'/SKILL.md',import.meta.url)).equals(fs.readFileSync(s.proposedSkillPath)));Object.assign(x.artifactBindings.find(b=>b.pluginId===id),{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',manifestSha256:p.knownInstalledManifestSha256,admissionReceiptSha256:'a'.repeat(64)});}const result=createV11(x);for(const id of ids){assert(result.proposal.nativeConfigFragment.plugins.allow.includes(id));const a=result.proposal.artifactAssignments.find(a=>a.pluginId===id);assert.equal(a.nativeConfigInclusionState,'REFERENCE_ONLY_NOT_RUNTIME_ADMISSION');assert.equal(a.referenceVerifiedByFactory,false);}pending(result);});
