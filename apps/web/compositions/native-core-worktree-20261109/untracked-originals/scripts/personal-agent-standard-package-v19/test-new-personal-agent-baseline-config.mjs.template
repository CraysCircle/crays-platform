/** Five prepared V19 source-intent tests; not runtime/persona/channel acceptance. */
import test from'node:test';import assert from'node:assert/strict';import fs from'node:fs';import{createHash}from'node:crypto';
import{getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create}from'./new-personal-agent-baseline-config.mjs';import{getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as createOld}from'../personal-agent-standard-package-v17/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),ADDED=['crays-personal-preferences','crays-learning-plan'],input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('direct canonical V17 full124 and47 obligations old20tools16skills preserved with two additive assignments',()=>{const a=create(input()),b=createOld(input(old));assert.equal(a.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(a.proposal.assignedBindingCapabilityIds,b.proposal.assignedBindingCapabilityIds);assert.deepEqual(a.proposal.assignedTools,[...b.proposal.assignedTools,'crays_personal_preferences','crays_learning_plan']);assert.equal(a.proposal.assignedTools.length,22);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);assert.deepEqual(std.descriptor.plugins.slice(0,-2),old.descriptor.plugins);assert.deepEqual(std.descriptor.capabilityComponentAssignments.slice(0,-2),old.descriptor.capabilityComponentAssignments);assert.deepEqual(std.descriptor.addedSkillAssignments.slice(0,-2),old.descriptor.addedSkillAssignments);assert(std.descriptor.addedSkillAssignments.some(s=>s.skillId==='crays-personal-budget'&&s.proposedArtifactRoot.endsWith('/5610766631db07ecddce7b6a3c6879520c8386812fb579b1d8a01dcbc4914c80')));});
test('both new skills are source assigned and no runtime tool is registered without artifact admission',()=>{const a=create(input()),b=createOld(input(old)),cfg=a.proposal.nativeConfigFragment,prior=b.proposal.nativeConfigFragment;assert.deepEqual(a.addedSkillAssignments.slice(0,-2),b.addedSkillAssignments);assert.deepEqual(cfg.agents.entries['agent-one'].skills,[...prior.agents.entries['agent-one'].skills,...ADDED]);assert.equal(cfg.agents.entries['agent-one'].skills.length,18);for(const tool of['crays_personal_preferences','crays_learning_plan'])assert(!cfg.tools.allow.includes(tool));assert.deepEqual(cfg.plugins,prior.plugins);for(const r of a.proposal.artifactAssignments.slice(-2))assert.equal(r.nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(a.proposal.readiness[k],false);assert.deepEqual(cfg.cron,prior.cron);});
test('actual Root files instruction bytes and public qualification references are exact but never readiness grants',()=>{for(const p of std.descriptor.plugins.slice(-2)){for(const r of Object.values(p.publicQualificationEvidence)){const raw=fs.readFileSync(r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);}for(const r of p.files){const raw=fs.readFileSync(p.artifactRoot+'/'+p.knownInstalledManifestSha256+'/'+r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);}assert.equal(p.fullCapabilityClosed,false);const s=std.descriptor.addedSkillAssignments.find(s=>s.skillId===p.id),bytes=fs.readFileSync(s.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),s.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/'+s.skillId+'/SKILL.md',import.meta.url))));assert.equal(s.nativeLoadVerified,false);}assert.equal(std.descriptor.publicPersonaPolicy.appliedByImmutableFactory,false);assert.equal(std.descriptor.publicPersonaPolicy.agentBrandSource,'infra/openclaw/agentic/agent-brand.json');assert.equal(std.descriptor.publicPersonaPolicy.brandLanguageSource,'infra/openclaw/agentic/brand-language.json');});
test('two persons keep own-login paths and credentials independent and qualified preferences hook reference is exact',()=>{for(const p of[create(input()),create(input(std,'person-two','agent-two'))]){assert.equal(p.proposal.modelAccountReadiness.state,'PENDING_OWN_LOGIN');assert.equal(p.proposal.modelAccountReadiness.readinessReceiptSha256,null);assert.equal(p.proposal.readiness.credentialsInherited,false);assert.equal(p.proposal.readiness.runtimeStartAllowed,false);}const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);const x=input();for(const r of x.artifactBindings.slice(-2)){r.state='INSTALLATION_ADMISSION_REFERENCE_SUPPLIED';r.manifestSha256=std.descriptor.plugins.find(p=>p.id===r.pluginId).knownInstalledManifestSha256;r.admissionReceiptSha256='1'.repeat(64);}const cfg=create(x).proposal.nativeConfigFragment;assert.deepEqual(cfg.plugins.entries['crays-personal-preferences'],{enabled:true,hooks:{allowPromptInjection:true,allowConversationAccess:true}});assert(cfg.tools.allow.includes('crays_personal_preferences')&&cfg.tools.allow.includes('crays_learning_plan'));assert.equal(create(x).proposal.readiness.runtimeStartAllowed,false);});
test('__CRAYS_PRIVATE_IDENTIFIER_cbbba69a62645bfbb765cf7a__ model identity credentials missing duplicate or forged either new plugin binding fail closed',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_cbbba69a62645bfbb765cf7a__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_cbbba69a62645bfbb765cf7a__',x=>x.modelAccount.token='DENIED',x=>x.expectedPackageSha256='0'.repeat(64),x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.at(-2).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[x.artifactBindings.length-2]=x.artifactBindings.at(-1),x=>{x.artifactBindings.at(-2).state='INSTALLATION_ADMISSION_REFERENCE_SUPPLIED';x.artifactBindings.at(-2).manifestSha256='0'.repeat(64);x.artifactBindings.at(-2).admissionReceiptSha256='1'.repeat(64);}]){const a=input();change(a);assert.throws(()=>create(a));}});
