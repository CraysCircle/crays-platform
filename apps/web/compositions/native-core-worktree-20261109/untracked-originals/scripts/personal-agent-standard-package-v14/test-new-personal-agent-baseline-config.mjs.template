/** PREPARED only: pure default intent, not native/account/runtime proof. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';
import {getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create} from './new-personal-agent-baseline-config.mjs';import {getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as createOld} from '../personal-agent-standard-package-v13/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('all124 retained; exactly Subscriptions added to intent and no runtime authority',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.proposal.assignedBindingCapabilityIds,o.proposal.assignedBindingCapabilityIds);assert.equal(x.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(x.proposal.assignedTools,[...o.proposal.assignedTools,'crays_subscriptions']);assert.deepEqual(std.descriptor.plugins.slice(0,-1),old.descriptor.plugins);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(x.proposal.readiness[k],false);});
test('existing Pantry and corrected Budget assignments preserved byte for byte',()=>{const x=create(input()),o=createOld(input(old));assert.deepEqual(x.addedSkillAssignments.slice(0,-1),o.addedSkillAssignments);assert.equal(x.proposal.nativeConfigFragment.agents.entries['agent-one'].skills.length,13);assert(!x.proposal.nativeConfigFragment.tools.allow.includes('crays_subscriptions'));});
test('two persons retain separate paths and own pending accounts',()=>{const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);assert.equal(a.proposal.artifactAssignments.at(-1).referenceVerifiedByFactory,false);assert.equal(a.proposal.artifactAssignments.at(-1).nativeConfigInclusionState,'SOURCE_ASSIGNED_NOT_REGISTERED');const p=std.descriptor.plugins.at(-1);assert.equal(p.originalNativeCasesQualified,9);assert.equal(p.nativeActorGrantProven,false);for(const[label,r]of Object.entries(p.publicQualificationEvidence)){const raw=fs.readFileSync(r.path);assert.equal(raw.length,r.bytes);assert.equal(createHash('sha256').update(raw).digest('hex'),r.sha256);const e=JSON.parse(raw);if(label==='component'){assert.equal(e.actualComponentProof.tapPassed,20);assert.equal(e.actualComponentProof.tapFailed,0);assert.equal(e.terminal.onlyOwnLeaseReturned,true);}else{assert.equal(e.status,'ACTUAL_ORIGINAL_NATIVE_NINE_CASES_PASS_SYNTHETIC_ONLY');assert.equal(e.actualChecks.cases.length,9);assert.equal(e.actualChecks.operationsCovered.length,9);assert.equal(e.onlyOwnLeaseReturned,true);assert.deepEqual(e.bindings.result,p.qualificationEvidence.originalNative);}}const skill=std.descriptor.addedSkillAssignments.at(-1),bytes=fs.readFileSync(skill.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),skill.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/crays-subscriptions/SKILL.md',import.meta.url))));});
test('__CRAYS_PRIVATE_IDENTIFIER_cea006e67407098d02d4b881__ account and duplicate/malformed/missing new artifact bindings denied',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_cea006e67407098d02d4b881__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_cea006e67407098d02d4b881__',x=>x.modelAccount.token='DENIED',x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop(),x=>x.artifactBindings[x.artifactBindings.length-2]=x.artifactBindings.at(-1)]){const x=input();change(x);assert.throws(()=>create(x));}});
