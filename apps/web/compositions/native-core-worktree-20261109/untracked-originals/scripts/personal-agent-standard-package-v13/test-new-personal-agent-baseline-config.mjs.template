/** Source-only proposed checks; not executed. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';
import {getPersonalAgentStandardPackage as get,createNewPersonalAgentStandardConfigWith124 as create} from './new-personal-agent-baseline-config.mjs';import {getPersonalAgentStandardPackage as getOld,createNewPersonalAgentStandardConfigWith124 as oldCreate} from '../personal-agent-standard-package-v12/new-personal-agent-baseline-config.mjs';
const std=get(),old=getOld(),input=(s=std,p='person-one',a='agent-one')=>({canonicalPersonId:p,agentId:a,expectedPackageVersion:s.descriptor.version,expectedPackageSha256:s.sha256,modelAccount:{canonicalPersonId:p,agentId:a,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:s.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
test('all124 obligations and prior15tools retained; Pantry adds one tool and one skill without authority',()=>{const x=create(input()),o=oldCreate(input(old));assert.equal(x.proposal.assignedBindingCapabilityIds.length,124);assert.deepEqual(x.proposal.assignedBindingCapabilityIds,o.proposal.assignedBindingCapabilityIds);assert.deepEqual(x.proposal.assignedTools,[...o.proposal.assignedTools,'crays_pantry']);assert.equal(x.proposal.nativeConfigFragment.agents.entries['agent-one'].skills.length,12);assert.deepEqual(std.descriptor.plugins.slice(0,-1),old.descriptor.plugins);for(const k of['binding100','binding107','binding124','additional124SkillAssignments','hookPlugins','requiredAccountRoute'])assert.deepEqual(std.descriptor[k],old.descriptor[k]);for(const k of['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(x.proposal.readiness[k],false);});
test('Budget instruction is superseded in proposed native extraDirs and skill assignment without mutating V12',()=>{const x=create(input()),a=old.descriptor.addedSkillAssignments.find(s=>s.skillId==='crays-personal-budget'),b=std.descriptor.addedSkillAssignments.find(s=>s.skillId==='crays-personal-budget');assert.equal(b.artifactManifestSha256Reference,'5610766631db07ecddce7b6a3c6879520c8386812fb579b1d8a01dcbc4914c80');assert(x.proposal.nativeConfigFragment.skills.load.extraDirs.includes(b.proposedExtraDir));assert(!x.proposal.nativeConfigFragment.skills.load.extraDirs.includes(a.proposedExtraDir));assert.equal(x.addedSkillAssignments.find(s=>s.skillId===b.skillId).contentSha256,b.contentSha256);assert.notEqual(a.contentSha256,b.contentSha256);const p=std.descriptor.plugins.at(-1),root=p.artifactRoot+'/'+p.knownInstalledManifestSha256,raw=fs.readFileSync(root+'/CRAYS_ARTIFACT_MANIFEST.json');assert.equal(createHash('sha256').update(raw).digest('hex'),p.knownInstalledManifestSha256);assert.deepEqual(JSON.parse(raw).files,p.files);for(const f of p.files)assert.equal(createHash('sha256').update(fs.readFileSync(root+'/'+f.path)).digest('hex'),f.sha256);for(const skill of[b,std.descriptor.addedSkillAssignments.at(-1)]){const bytes=fs.readFileSync(skill.proposedSkillPath);assert.equal(createHash('sha256').update(bytes).digest('hex'),skill.contentSha256);assert(bytes.equals(fs.readFileSync(new URL('./source-skills/'+skill.skillId+'/SKILL.md',import.meta.url))));}});
test('two person proposals have distinct paths and Pantry never borrows account/model readiness',()=>{const a=create(input()),b=create(input(std,'person-two','agent-two'));for(const k of['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[k],b.proposal.paths[k]);assert(!a.proposal.nativeConfigFragment.tools.allow.includes('crays_pantry'));assert.equal(std.descriptor.plugins.at(-1).originalNativeCasesQualified,10);assert.equal(std.descriptor.plugins.at(-1).nativeActorGrantProven,false);const p=std.descriptor.plugins.at(-1);for(const [label,r]of Object.entries(p.publicQualificationEvidence)){const b=fs.readFileSync(r.path);assert.equal(b.length,r.bytes);assert.equal(createHash('sha256').update(b).digest('hex'),r.sha256);const e=JSON.parse(b);if(label==='component'){assert.equal(e.status,'ACTUAL_COMPONENT18_PASS');assert.equal(e.componentProof.tapPassed,18);assert.equal(e.componentProof.tapFailed,0);assert.equal(e.onlyOwnLeaseReturned,true);}else{assert.equal(e.status,'ACTUAL_ORIGINAL_NATIVE_TEN_CASES_PASS_SYNTHETIC_ONLY');assert.equal(e.actualChecks.cases.length,10);assert.equal(e.actualChecks.operationsTested.length,13);assert.deepEqual(e.bindings.result,p.qualificationEvidence.originalNative);}}});
test('__CRAYS_PRIVATE_IDENTIFIER_c4bde3af8b0fd15ce7ec8356__ credentials and malformed new bindings denied',()=>{for(const change of[x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_c4bde3af8b0fd15ce7ec8356__',x=>x.modelAccount.agentId='__CRAYS_PRIVATE_IDENTIFIER_c4bde3af8b0fd15ce7ec8356__',x=>x.modelAccount.token='DENIED',x=>x.artifactBindings.at(-1).codeSetSha256='0'.repeat(64),x=>x.artifactBindings.pop()]){const x=input();change(x);assert.throws(()=>create(x));}});
