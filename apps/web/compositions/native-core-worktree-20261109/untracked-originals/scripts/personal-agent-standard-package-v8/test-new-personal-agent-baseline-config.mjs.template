/** Focused V8 assignment/version tests ONLY: no renderer import, database, model, provider or runtime calls. */
import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';
import {getPersonalAgentStandardPackage as getV8,createNewPersonalAgentStandardConfigWith124 as createV8} from './new-personal-agent-baseline-config.mjs';
import {getPersonalAgentStandardPackage as getV7,createNewPersonalAgentStandardConfigWith124 as createV7} from '../personal-agent-standard-package-v7/new-personal-agent-baseline-config.mjs';
const modern=getV8(),legacy=getV7(),ID='crays-document-exports',TOOL='crays_document_exports';
const root='/opt/crays/openclaw/plugin-artifacts/crays-document-exports/79e34b46af23d2f9f092b4a918658fb4557d9734113e7b58e5bfe2c74dc6b63b',skillRoot='/opt/crays/openclaw/skill-artifacts/crays-document-exports/43d3b8b90d3c307849ede5ba59392b62d93cb7623e8562b5eb7afbb00527592d';
const hex=bytes=>createHash('sha256').update(bytes).digest('hex');
const plugin=p=>p.descriptor.plugins.find(x=>x.id===ID);
const input=(standard=modern,person='person-one',agent='agent-one')=>({canonicalPersonId:person,agentId:agent,expectedPackageVersion:standard.descriptor.version,expectedPackageSha256:standard.sha256,modelAccount:{canonicalPersonId:person,agentId:agent,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:standard.descriptor.plugins.map(p=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});
const binding=x=>x.artifactBindings.find(p=>p.pluginId===ID);
function referenced(x=input()){Object.assign(binding(x),{state:'INSTALLATION_ADMISSION_REFERENCE_SUPPLIED',manifestSha256:plugin(modern).knownInstalledManifestSha256,admissionReceiptSha256:'a'.repeat(64)});return x;}
function pending(result){const p=result.proposal;for(const key of ['runtimeStartAllowed','ownAccountVerified','artifactAdmissionVerified','credentialsInherited'])assert.equal(p.readiness[key],false);assert.equal(p.modelAccountReadiness.state,'PENDING_OWN_LOGIN');assert.equal(p.modelAccountReadiness.referenceVerifiedByFactory,false);}
test('V8 gives two people the same124 source obligations/10 assignedtools/7skills while separating all private paths and own account intent',()=>{
 const a=createV8(input()),b=createV8(input(modern,'person-two','agent-two')),old=createV7(input(legacy));
 assert.deepEqual(a.proposal.assignedBindingCapabilityIds,old.proposal.assignedBindingCapabilityIds);assert.equal(new Set(a.proposal.assignedBindingCapabilityIds).size,124);assert.deepEqual(b.proposal.assignedBindingCapabilityIds,a.proposal.assignedBindingCapabilityIds);assert.deepEqual(a.proposal.assignedTools,old.proposal.assignedTools);assert.equal(a.proposal.assignedTools.length,10);
 assert.equal(a.proposal.nativeConfigFragment.agents.entries['agent-one'].skills.length,7);assert.equal(b.proposal.nativeConfigFragment.agents.entries['agent-two'].skills.length,7);for(const key of ['stateDir','workspace','agentDir'])assert.notEqual(a.proposal.paths[key],b.proposal.paths[key]);assert.notEqual(a.proposal.personNamespace,b.proposal.personNamespace);pending(a);pending(b);
 for(const result of [a,b]){const hook=result.proposal.hookArtifactAssignments[0];for(const key of ['accountId','recipient','channelId','nativeConfigPatch'])assert.equal(hook[key],null);assert.equal(hook.nativeConfigEnabled,false);assert(!result.proposal.nativeConfigFragment.plugins.allow.includes('crays-service-notices'));}
});
test('source assignment alone does not register exports; exact0.6 reference proposes ONLY one exporttool and root-level six-format artifact without verifying admission',()=>{
 const a=createV8(input()),b=createV8(referenced()),before=a.proposal.nativeConfigFragment,after=b.proposal.nativeConfigFragment;assert(!before.tools.allow.includes(TOOL));assert(!before.plugins.allow.includes(ID));assert.equal(a.proposal.artifactAssignments.find(x=>x.pluginId===ID).proposedLoadPath,null);
 assert.deepEqual(after.tools.allow,[...before.tools.allow,TOOL]);assert.deepEqual(after.agents.entries['agent-one'].tools.allow,[...before.agents.entries['agent-one'].tools.allow,TOOL]);assert.deepEqual(after.plugins.load.paths,[...before.plugins.load.paths,root]);assert.equal(after.plugins.entries[ID].enabled,true);assert.equal(b.proposal.artifactAssignments.find(x=>x.pluginId===ID).proposedLoadPath,root);assert.equal(b.proposal.artifactAssignments.find(x=>x.pluginId===ID).referenceVerifiedByFactory,false);pending(b);
 assert.deepEqual(plugin(modern).availableFormats,['txt','csv','xlsx','pptx','pdf','docx']);assert.equal(plugin(modern).version,'0.6.0');assert.equal(plugin(legacy).version,'0.3.0');
});
test('old XLSX code-set or admission cannot masquerade as six-format0.6 and genuine V7 history stays byte-identical',()=>{
 const old=plugin(legacy),current=plugin(modern);assert.notEqual(old.codeSetSha256,current.codeSetSha256);assert.equal(current.codeSetSha256,'64b314101315d6abe82dcd022f5c21577d0a2457b7c1c2f6393bddebf28c4f6f');
 for(const mutate of [x=>binding(x).codeSetSha256=old.codeSetSha256,x=>binding(x).manifestSha256=old.knownInstalledManifestSha256,x=>Object.assign(binding(x),{codeSetSha256:old.codeSetSha256,manifestSha256:old.knownInstalledManifestSha256})]){const x=referenced();mutate(x);assert.throws(()=>createV8(x));}
 assert.equal(createV7(input(legacy)).proposal.standardPackage.version,legacy.descriptor.version);
 const previousHashes={"STANDARD_PACKAGE.json": "10a1fcb62c23e93ec2e9f785b5aa229bdb957b45d3b98e7100b0d4fd8b854d73", "new-personal-agent-baseline-config.mjs": "a0d681cb8fb8113807766bb88c2e2fb8982ce6b091fcf6b5e7769dec62ec3635", "test-new-personal-agent-baseline-config.mjs": "4710bd74bf1be2af22f4402a2b8724360d5c86c17f9702a5792c0be76bd912e0"};
 for(const [name,expected]of Object.entries(previousHashes))assert.equal(hex(fs.readFileSync(new URL('../personal-agent-standard-package-v7/'+name,import.meta.url))),expected);
 assert.deepEqual(modern.descriptor.plugins.filter(p=>p.id!==ID),legacy.descriptor.plugins.filter(p=>p.id!==ID));assert.deepEqual(modern.descriptor.binding124,legacy.descriptor.binding124);assert.deepEqual(modern.descriptor.additional124SkillAssignments,legacy.descriptor.additional124SkillAssignments);assert.deepEqual(modern.descriptor.hookPlugins,legacy.descriptor.hookPlugins);
});
test('assigned six-format instruction resolves to actual Root-staged exactbytes while retained metadata never claims native/user readiness',()=>{
 const result=createV8(input()),skill=modern.descriptor.addedSkillAssignments.find(x=>x.skillId===ID);assert.equal(skill.proposedExtraDir,skillRoot+'/skills');assert.equal(skill.proposedSkillPath,skillRoot+'/skills/'+ID+'/SKILL.md');
 assert.equal(hex(fs.readFileSync(skillRoot+'/CRAYS_SKILL_ARTIFACT_MANIFEST.json')),'43d3b8b90d3c307849ede5ba59392b62d93cb7623e8562b5eb7afbb00527592d');assert.equal(hex(fs.readFileSync(skill.proposedSkillPath)),'eeafc2dec9db5a4991dcbef6c69dc3a74798eca3fb00ef717d9e269e3f7e95a3');assert.equal(skill.contentSha256,'eeafc2dec9db5a4991dcbef6c69dc3a74798eca3fb00ef717d9e269e3f7e95a3');assert.equal(skill.nativeLoadVerified,false);assert.equal(skill.userAcceptanceProven,false);assert(result.proposal.nativeConfigFragment.skills.load.extraDirs.includes(skillRoot+'/skills'));assert(Object.isFrozen(result.proposal.nativeConfigFragment.agents.entries['agent-one'].tools));pending(result);
 const originalManifest=fs.readFileSync(root+'/CRAYS_ARTIFACT_MANIFEST.json');assert.equal(hex(originalManifest),'79e34b46af23d2f9f092b4a918658fb4557d9734113e7b58e5bfe2c74dc6b63b');const actual=JSON.parse(originalManifest);assert.equal(actual.version,'0.6.0');assert.deepEqual(plugin(modern).files,actual.files.map(r=>({path:r.relative,bytes:r.bytes,sha256:r.sha256})));
});
