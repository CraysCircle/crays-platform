 for(const mutate of [x=>x.modelAccount.canonicalPersonId='__CRAYS_PRIVATE_IDENTIFIER_e2ffa67de7a94746b9405e2c__',x=>x.modelAccount.agentId='foreign-agent',x=>x.modelAccount.provider='foreign',x=>x.modelAccount.apiRoute='foreign-route',x=>x.modelAccount.token='SYNTHETIC_DENIED',x=>x.workspace='/foreign',x=>x.artifactBindings.pop(),x=>x.artifactBindings[0]=structuredClone(binding(x)),x=>binding(x).proposedLoadPath='/foreign']){const x=input();mutate(x);assert.throws(()=>createV8(x));}
