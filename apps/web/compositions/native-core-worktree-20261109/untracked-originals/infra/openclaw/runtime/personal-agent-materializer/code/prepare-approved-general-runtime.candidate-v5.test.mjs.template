import test from 'node:test';import assert from 'node:assert/strict';import{createHash}from'node:crypto';
import {composeApprovedGeneralRuntime as compose,prepareApprovedGeneralRuntime as prepare,prepareChannelIndependentGeneralRuntime as entry,verifyApprovedGeneralRuntimeArtifacts as verify}from'./prepare-approved-general-runtime.candidate-v5.mjs';
import {composeApprovedGeneralRuntime as oldCompose}from'./prepare-approved-general-runtime.candidate-v3.mjs';
import DEPLOY from'./approved-general-baseline-v5-catalogue-source-v1/FINAL_CHANNEL_INDEPENDENT_PROJECTION.json'with{type:'json'};
import S from'./approved-general-baseline-composition-v3/INPUT_PROJECTED_RUNTIME_STANDARD.json'with{type:'json'};
import R from'./approved-general-baseline-composition-v3/reminders/REMINDER_BASELINE_BINDINGS.json'with{type:'json'};
import L from'./approved-general-baseline-composition-v3/selected-local-skills/ARTIFACT_BINDINGS.json'with{type:'json'};
import M from'./approved-general-baseline-composition-v3/multipart-pdf/ARTIFACT_BINDINGS.json'with{type:'json'};
import INPUTCAT from'./approved-general-baseline-composition-v3/INPUT_HOST_ARTIFACT_CATALOG.json'with{type:'json'};
const hash=x=>createHash('sha256').update(x).digest('hex');
function fixture(person,sender){const id='personal-'+hash('crays.personal-agent.assignment.v1\n'+person).slice(0,48),runtime='/var/lib/crays-personal-agents/'+hash('crays.personal-agent.person-namespace.v1\n'+person)+'/'+id,account='fixture-business-'+person,policy={profile:'full',allow:[...S.descriptor.tools],deny:[],fs:{workspaceOnly:true}},channel={enabled:true,dmPolicy:'allowlist',groupPolicy:'disabled',configWrites:false,allowFrom:[sender]};return {context:{canonicalPersonId:person,agentId:id,runtime},base:{tools:structuredClone(policy),agents:{defaults:{timeoutSeconds:120,heartbeat:{every:'0m',target:'none'}},entries:{[id]:{workspace:runtime+'/workspace',agentDir:runtime+'/agents/'+id+'/agent',tools:structuredClone(policy),skills:[...S.descriptor.skills],heartbeat:{every:'0m',target:'none'},model:{primary:'openai/fixture-own-model',fallbacks:[]}}}},skills:{load:{extraDirs:[...L.artifacts.map(x=>x.extraDir)]},entries:Object.fromEntries(S.descriptor.skills.map(x=>[x,{enabled:true}]))},plugins:{allow:[...R.pluginAllow],load:{paths:[M.oldPluginRoot]},entries:Object.fromEntries(R.pluginAllow.map(x=>[x,{enabled:true}]))},auth:{profiles:{['own-'+person]:{provider:'openai',mode:'oauth'}},order:{openai:['own-'+person]}},channels:{whatsapp:{...channel,accounts:{[account]:structuredClone(channel)}}},bindings:[{agentId:id,match:{channel:'whatsapp',accountId:account}}],commands:{ownerAllowFrom:['whatsapp:'+sender]},cron:{enabled:false},hooks:{enabled:false}}};}

function person(name){const x=fixture(name,'__CRAYS_PRIVATE_LITERAL_854d92653fc7d955fc8d009f__');delete x.base.channels;delete x.base.bindings;delete x.base.commands;delete x.base.auth;x.base.skills.load.extraDirs=INPUTCAT.skills.map(s=>s.root+'/skills');x.base.plugins.load.paths=INPUTCAT.plugins.map(p=>p.root);return x;}
function projection(x){const p=structuredClone(DEPLOY),l=p.legacyProjection;l.instructionAliases=l.instructionAliasSuffixes.map(a=>({runtimePath:x.context.runtime+a.runtimeSuffix,artifactPath:a.artifactPath}));delete l.instructionAliasSuffixes;return p;}
function receipt(x){return {accountId:'synthetic-account-'+x.context.canonicalPersonId,canonicalPersonId:x.context.canonicalPersonId,agentId:x.context.agentId,agentDir:x.context.runtime+'/agents/'+x.context.agentId+'/agent',provider:'openai',apiRoute:'openai-chatgpt-responses',profileRef:'synthetic-own-profile',receiptSha256:'1'.repeat(64),expiresAtMs:Date.now()+60000};}
function pureGuard(){let live=true;return {check:()=>{assert(live,'SYNTHETIC_PURE_SCOPE_CLOSED');},close:()=>{live=false;}};}
test('two synthetic Core persons compose V5 through ORIGINAL legacy helper without owner or channel borrowing',()=>{const ids=[];for(const name of ['new-helper-alice','new-helper-bob']){const x=person(name),p=projection(x),before=JSON.stringify(x.base),g=pureGuard(),legacy=oldCompose(x.base,x.context,p.legacyProjection),r=compose(x.base,x.context,p,{assertInvocationCurrent:g.check});g.close();assert.equal(r.toolCount,29);assert.equal(r.skillCount,32);assert.equal(r.runtimeStarted,false);assert.equal(r.nativeToolRegistryLoaded,false);assert.equal(r.defaultFactorySwitched,false);assert.equal(r.ownAccountReadinessVerified,false);assert.equal(r.pendingBranches.length,1);assert.equal(JSON.stringify(x.base),before);assert.deepEqual(r.standard.descriptor.skills,DEPLOY.standard.descriptor.skills);assert.deepEqual(r.config.tools,legacy.config.tools);assert.deepEqual(r.config.plugins,legacy.config.plugins);assert.strictEqual(r.config.channels,x.base.channels);assert.strictEqual(r.config.auth,x.base.auth);assert(!JSON.stringify(r.config).includes('crays-agent-thorben'));assert(!JSON.stringify(r.config).includes('/run/crays-owner-tools-whatsapp-live'));ids.push(x.context.agentId);}assert.notEqual(ids[0],ids[1]);});
test('final fields/legacy manifests/fixed roots/alias person cannot be caller-relaxed',()=>{for(const change of[p=>p.standard.descriptor.tools.push('exec'),p=>p.legacyProjection.catalog.plugins.pop(),p=>p.fixedGuides[0].root='/opt/foreign',p=>p.fixedGuides.pop(),p=>p.legacyProjection.instructionAliases[0].runtimePath='/var/lib/foreign/code/skills',p=>p.standard.descriptor.skills.reverse()]){const x=person('mutated'),p=projection(x);change(p);const g=pureGuard();assert.throws(()=>compose(x.base,x.context,p,{assertInvocationCurrent:g.check}));g.close();}});
test('connected own WhatsApp is expressly excluded, not granted automations by this helper',async()=>{const x=fixture('connected-denial','__CRAYS_PRIVATE_LITERAL_854d92653fc7d955fc8d009f__');let checks=0;await assert.rejects(entry(x.base,x.context,{recheckHost:async()=>{checks++;return receipt(x);}}),/CHANNEL_INDEPENDENT_ONLY/);assert.equal(checks,0);});
test('authority recheck is mandatory and revoked/expired/foreign receipts fail before artifact verification',async()=>{const x=person('authority-denial');await assert.rejects(entry(x.base,x.context),/REAL_ASYNC_HOST_RECHECK_REQUIRED/);for(const change of[a=>a.canonicalPersonId='foreign',a=>a.agentId='foreign',a=>a.agentDir='/foreign',a=>a.profileRef='constructor',a=>a.receiptSha256='bad',a=>a.expiresAtMs=0]){let count=0;const a=receipt(x);change(a);await assert.rejects(entry(x.base,x.context,{recheckHost:async()=>{count++;return a;}}));assert.equal(count,1);}await assert.rejects(entry(x.base,x.context,{recheckHost:async()=>{throw Error('COMMITTED_ASSIGNMENT_REVOKED');}}),/COMMITTED_ASSIGNMENT_REVOKED/);});
test('fixed catalogue entry normalizes only missing dormant defaults without injecting auth/routes',()=>{const x=person('not-normalized');delete x.base.agents.defaults.heartbeat;delete x.base.agents.entries[x.context.agentId].heartbeat;const p=projection(x),g=pureGuard();assert.throws(()=>compose(x.base,x.context,p,{assertInvocationCurrent:g.check}));g.close();});
test('artifact reverify cannot admit a changed fixed root or legacy descriptor',async()=>{const x=person('reverify-denial'),g=pureGuard(),r=compose(x.base,x.context,projection(x),{assertInvocationCurrent:g.check});g.close();r.fixedGuides[0].root='/opt/foreign';await assert.rejects(verify(r),/EXACT_THREE_FIXED_GUIDES_REQUIRED/);});
test('original strict public Root artifacts + fixed3 verifier retain top-level materializer contract and await real host checks twice',async()=>{
 const x=person('actual-readonly-artifact-integration');let calls=0;const a=receipt(x);const r=await entry(x.base,x.context,{recheckHost:async()=>{calls++;await Promise.resolve();return {...a};}});
 assert.equal(calls,2);assert.equal(r.status,'GENERAL_V5_FIXED_GUIDES_ARTIFACTS_VERIFIED_NOT_ADMITTED');assert.equal(r.toolCount,29);assert.equal(r.skillCount,32);assert.equal(r.hostRecheckedBeforeAndAfterArtifactIO,true);assert.equal(r.synchronousCompositionScopeClosed,true);assert.equal(r.defaultFactorySwitched,false);assert.equal(r.ownAccountReadinessVerified,false);
 assert(r.artifacts.plugins.length>0);assert.deepEqual(r.artifacts.plugins,r.artifacts.legacy.plugins);assert.equal(r.artifacts.skills.length,31);assert.equal(r.artifacts.fixedGuides.skills.length,3);assert.deepEqual(r.artifacts.skills.map(s=>s.name).sort(),r.standard.descriptor.skills.filter(s=>s!=='weather').sort());assert(/^[0-9a-f]{64}$/.test(r.artifacts.sha256));assert.equal(r.artifacts.authorityGranted,false);assert.equal(r.artifacts.nativeReadonlyAliasesVerified,false);
 // Consequential new async-boundary test: real strict artifact reads complete, then host revokes.
 calls=0;await assert.rejects(entry(x.base,x.context,{recheckHost:async()=>{if(++calls===2)throw Error('POST_ARTIFACT_AUTHORITY_REVOKED');return {...a};}}),/POST_ARTIFACT_AUTHORITY_REVOKED/);assert.equal(calls,2);
});
test('pure compose rejects async callback instead of misusing asynchronous host authority',()=>{const x=person('async-denial');assert.throws(()=>compose(x.base,x.context,projection(x),{assertInvocationCurrent:async()=>{}}),/ASYNC_CURRENTNESS_DENIED/);});
