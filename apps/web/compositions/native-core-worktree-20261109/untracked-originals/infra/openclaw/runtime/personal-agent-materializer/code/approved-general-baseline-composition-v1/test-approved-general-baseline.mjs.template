import test from'node:test';import assert from'node:assert/strict';import{createHash}from'node:crypto';
import {composeApprovedGeneralBaseline as compose}from'./compose-approved-general-baseline.mjs';
import S from'./INPUT_PROJECTED_RUNTIME_STANDARD.json'with{type:'json'};import R from'./reminders/REMINDER_BASELINE_BINDINGS.json'with{type:'json'};import L from'./selected-local-skills/ARTIFACT_BINDINGS.json'with{type:'json'};import M from'./multipart-pdf/ARTIFACT_BINDINGS.json'with{type:'json'};
const hash=x=>createHash('sha256').update(x).digest('hex');
function fixture(person,sender){const id='personal-'+hash('crays.personal-agent.assignment.v1\n'+person).slice(0,48),runtime='/var/lib/crays-personal-agents/'+hash('crays.personal-agent.person-namespace.v1\n'+person)+'/'+id,account='fixture-business-'+person,policy={profile:'full',allow:[...S.descriptor.tools],deny:[],fs:{workspaceOnly:true}},channel={enabled:true,dmPolicy:'allowlist',groupPolicy:'disabled',configWrites:false,allowFrom:[sender]};return {context:{canonicalPersonId:person,agentId:id,runtime},base:{tools:structuredClone(policy),agents:{defaults:{timeoutSeconds:120,heartbeat:{every:'0m',target:'none'}},entries:{[id]:{workspace:runtime+'/workspace',agentDir:runtime+'/agents/'+id+'/agent',tools:structuredClone(policy),skills:[...S.descriptor.skills],heartbeat:{every:'0m',target:'none'},model:{primary:'openai/fixture-own-model',fallbacks:[]}}}},skills:{load:{extraDirs:[...L.artifacts.map(x=>x.extraDir)]},entries:Object.fromEntries(S.descriptor.skills.map(x=>[x,{enabled:true}]))},plugins:{allow:[...R.pluginAllow],load:{paths:[M.oldPluginRoot]},entries:Object.fromEntries(R.pluginAllow.map(x=>[x,{enabled:true}]))},auth:{profiles:{['own-'+person]:{provider:'openai',mode:'oauth'}},order:{openai:['own-'+person]}},channels:{whatsapp:{...channel,accounts:{[account]:structuredClone(channel)}}},bindings:[{agentId:id,match:{channel:'whatsapp',accountId:account}}],commands:{ownerAllowFrom:['whatsapp:'+sender]},cron:{enabled:false},hooks:{enabled:false}}};}
function freeze(x){if(x&&typeof x==='object'){Object.values(x).forEach(freeze);Object.freeze(x);}return x;}
test('two canonical persons compose exact30/29 through original pure steps with no connection borrowing',()=>{for(const [person,sender]of[['alice','__CRAYS_PRIVATE_LITERAL_ea779e4445c87714eefe1b41__'],['bob','__CRAYS_PRIVATE_LITERAL_a5943fa56ecacdc9ab3616e3__']]){const x=fixture(person,sender),before=structuredClone(x.base);freeze(x.base);const r=compose(x.base,x.context),c=r.candidateConfig;assert.equal(r.status,'SOURCE_COMPOSED_NOT_ADMITTED');assert.equal(r.toolCount,30);assert.equal(r.instructionCount,29);assert.equal(r.runtimeStarted,false);assert.deepEqual(x.base,before);for(const k of['auth','channels','bindings','commands','hooks'])assert.strictEqual(c[k],x.base[k]);assert.equal(c.agents.defaults.timeoutSeconds,300);assert.equal(c.cron.enabled,true);assert.equal(c.tts.auto,'off');assert.equal(c.plugins.entries['crays-personal-reminder-policy'].config.bindings[0].senderId,sender);assert(c.skills.load.extraDirs.includes(x.context.runtime+'/code/cited-research/skills'));assert(!JSON.stringify(c).includes('crays-agent-thorben'));assert(!JSON.stringify(c).includes('/run/crays-owner-tools-whatsapp-live'));}});
test('missing own channel stays pending with no candidate runtime config',()=>{const x=fixture('alice','__CRAYS_PRIVATE_LITERAL_ea779e4445c87714eefe1b41__');delete x.base.channels;delete x.base.bindings;const r=compose(x.base,x.context);assert.equal(r.status,'PENDING_OWN_CHANNEL');assert.equal(r.candidateConfig,null);assert.equal(r.runtimeStarted,false);assert.equal(r.assignedToolNames.length,30);});
test('deny cross-person host context, route mismatch, extras, duplicates and unknown budgets',()=>{for(const change of[x=>x.context.canonicalPersonId='bob',x=>x.context.runtime+='/other',x=>x.base.bindings[0].agentId='personal-'+hash('foreign').slice(0,48),x=>x.base.channels.whatsapp.accounts.other={enabled:true},x=>x.base.tools.allow.push('exec'),x=>x.base.agents.entries[x.context.agentId].skills.push('unapproved'),x=>x.base.skills.load.extraDirs.push(L.artifacts[0].extraDir),x=>x.base.agents.defaults.timeoutSeconds=999,x=>x.base.cron.enabled=true]){const x=fixture('alice','__CRAYS_PRIVATE_LITERAL_ea779e4445c87714eefe1b41__');change(x);assert.throws(()=>compose(x.base,x.context));}});
test('new candidate cannot be reapplied or silently accept prior30/29 as V20',()=>{const x=fixture('alice','__CRAYS_PRIVATE_LITERAL_ea779e4445c87714eefe1b41__');const r=compose(x.base,x.context);assert.throws(()=>compose(r.candidateConfig,x.context));});
