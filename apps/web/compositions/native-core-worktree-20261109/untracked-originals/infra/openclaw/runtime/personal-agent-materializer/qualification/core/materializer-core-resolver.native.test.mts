/** Three focused REAL disposable SQL resolver cases; historical V16 negative13 is not replayed. */
import assert from'node:assert/strict';import{createHash,randomUUID}from'node:crypto';import{Pool,type PoolClient}from'pg';
import{assignPersonalAgentInTransaction,type VerifiedProviderAccount}from'../crays-platform/src/db/personal-agent-assignment.ts';
import *as standardFactory from'../scripts/personal-agent-standard-package-v17/new-personal-agent-baseline-config.mjs';
import{getPersonalAgentStandardPackage as getV16,createNewPersonalAgentStandardConfigWith124 as createV16}from'../scripts/personal-agent-standard-package-v16/new-personal-agent-baseline-config.mjs';
import{getEverydayAssistanceSkillAssignment}from'../scripts/personal-agent-standard-package-v2/with-everyday-assistance.mjs';import{createCoreAssignmentResolver}from'./materializer/resolve-core-assignment.mjs';
const hash=(s:string)=>createHash('sha256').update(s).digest('hex');
export async function exerciseCommittedCoreMaterializerResolver(observer:PoolClient,socket:string){
 const pool=new Pool({host:socket,port:5432,user:'craysdev',database:'crays_assignment_test',connectionTimeoutMillis:5000,query_timeout:10000,max:3}),standard=standardFactory.getPersonalAgentStandardPackage(),suffix=randomUUID(),cases:string[]=[];let acquisitions=0;
 const resolver=createCoreAssignmentResolver({getClient:async()=>{acquisitions++;return pool.connect();},standardFactory}),resolve=(a:VerifiedProviderAccount)=>resolver(a,standard),personFor=(a:VerifiedProviderAccount)=>a.accountId+'-person',agentFor=(p:string)=>'personal-'+hash('crays.personal-agent.assignment.v1\n'+p).slice(0,48);
 const tx=async<T>(fn:()=>Promise<T>)=>{await observer.query('begin');try{const r=await fn();await observer.query('commit');return r;}catch(e){await observer.query('rollback');throw e;}};
 const seed=async(name:string)=>{const accountId='materializer-v17-focused-'+suffix+'-'+name,a:VerifiedProviderAccount={accountId,providerKey:'auth0',providerSubject:accountId+'-subject'};await tx(async()=>{await observer.query(`insert into crays_core.crays_accounts(account_id,crays_id,display_name,default_role,status) values($1,$1,'Synthetic V17 delta','gym-member','review')`,[accountId]);await observer.query(`insert into crays_core.auth_identities(identity_id,account_id,method_type,provider_key,provider_subject) values($1,$1,'social','auth0',$2)`,[accountId,a.providerSubject]);await observer.query(`insert into crays_core.canonical_people(canonical_person_id,person_version,account_id,display_name_sha256,encrypted_display_name_ref,field_authority_version,lifecycle_state) values($1,1,$2,repeat('a',64),'secret://synthetic-disposable-v17-focused','synthetic-only','review')`,[personFor(a),accountId]);});return a;};
 const proposal=(a:VerifiedProviderAccount,old=false)=>{const f=old?{getPersonalAgentStandardPackage:getV16,createNewPersonalAgentStandardConfigWith124:createV16}:standardFactory,v=f.getPersonalAgentStandardPackage(),canonicalPersonId=personFor(a),agentId=agentFor(canonicalPersonId);return f.createNewPersonalAgentStandardConfigWith124({canonicalPersonId,agentId,expectedPackageVersion:v.descriptor.version,expectedPackageSha256:v.sha256,modelAccount:{canonicalPersonId,agentId,provider:'openai',apiRoute:'openai-chatgpt-responses',modelRef:'openai/gpt-6-astra',state:'PENDING_OWN_LOGIN',readinessReceiptSha256:null},artifactBindings:v.descriptor.plugins.map((p:{id:string;codeSetSha256:string})=>({pluginId:p.id,codeSetSha256:p.codeSetSha256,manifestSha256:null,state:'SOURCE_ASSIGNED',admissionReceiptSha256:null}))});};
 const delivery=async(a:VerifiedProviderAccount,o:unknown,v=standard,when='2000-01-01T00:00:00Z')=>observer.query(`insert into crays_core.personal_agent_baseline_deliveries(canonical_person_id,package_version,account_id,agent_id,package_sha256,assignment_proposal,created_at) values($1,$2,$3,$4,$5,$6::jsonb,$7::timestamptz)`,[personFor(a),v.descriptor.version,a.accountId,agentFor(personFor(a)),v.sha256,JSON.stringify(o),when]);
 try{
  const alice=await seed('alice');await tx(()=>assignPersonalAgentInTransaction(observer,alice));const captured=await resolve(alice);await captured.assertCurrent();const rows=(await observer.query('select to_jsonb(d) record from crays_core.personal_agent_baseline_deliveries d where canonical_person_id=$1',[personFor(alice)])).rows;assert.equal(rows.length,1);const committed=rows[0].record.assignment_proposal;assert.deepEqual(committed,proposal(alice));assert.equal(committed.proposal.assignedBindingCapabilityIds.length,124);assert.equal(committed.proposal.assignedTools.length,20);assert.equal(committed.proposal.nativeConfigFragment.agents.entries[captured.agentId].skills.length,16);const p=standard.descriptor.plugins.find(x=>x.id==='crays-packing');assert(p);assert(committed.proposal.assignedTools.includes(p.tool));assert.equal(captured.packageSha256,standard.sha256);cases.push('actual-committed-v17-auth0-person-exact-packing-factory-intent-resolves124-20-16');
  const old=getV16();await tx(()=>delivery(alice,proposal(alice,true),old,'2099-01-01T00:00:00Z'));await assert.rejects(()=>resolve(alice),(e:Error)=>e.message.includes('CURRENT_BASELINE_VERSION_REQUIRED'));await assert.rejects(()=>captured.assertCurrent(),(e:Error)=>e.message.includes('CURRENT_BASELINE_VERSION_REQUIRED'));const preserved=(await observer.query('select to_jsonb(d) record from crays_core.personal_agent_baseline_deliveries d where canonical_person_id=$1 and package_version=$2',[personFor(alice),standard.descriptor.version])).rows;assert.deepEqual(preserved,rows);cases.push('committed-latest-v16-denied-no-v17-history-fallback-and-fresh-assertCurrent-rechecks');
  const tamper=await seed('packing-tamper'),o=structuredClone(proposal(tamper));const toolIndex=o.proposal.assignedTools.indexOf('crays_packing');assert(toolIndex>=0);o.proposal.assignedTools.splice(toolIndex,1);await tx(async()=>{await observer.query(`insert into crays_core.personal_agent_standard_assignments(canonical_person_id,account_id,agent_id,package_version,package_sha256,everyday_skill_sha256,assignment_proposal) values($1,$2,$3,$4,$5,$6,$7::jsonb)`,[personFor(tamper),tamper.accountId,agentFor(personFor(tamper)),standard.descriptor.version,standard.sha256,getEverydayAssistanceSkillAssignment().contentSha256,JSON.stringify(o)]);await delivery(tamper,o);});await assert.rejects(()=>resolve(tamper),(e:Error)=>e.message.includes('EXACT_COMMITTED_BASELINE_INTENT_REQUIRED'));cases.push('packing-only-committed-proposal-tamper-denied-against-actual-v17-factory');
  assert.equal(cases.length,3);assert.equal(acquisitions,5);return{status:'PASS',cases,caseCount:3,currentPackageVersion:standard.descriptor.version,currentPackageSha256:standard.sha256,capabilityCount:124,toolCount:20,skillCount:16,realCommittedPostgresTransactions:true,actualAssignmentCommand:true,actualResolverUnchanged:true,freshAssertCurrentRead:true,historicalV16Core13Rerun:false,routeAuthenticatedCallerSynthetic:true,realAccountOrAuthDataRead:false,ownAccountReadinessOrRuntimeAdmissionClaimed:false,runtimeStarted:false};
 }finally{await pool.end();}
}
