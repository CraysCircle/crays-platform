import test from'node:test';import assert from'node:assert/strict';import{createHash}from'node:crypto';import fs from'node:fs';
import {composeApprovedGeneralBaseline as compose,composeFixedGeneralInstructions as fixed}from'./compose-approved-general-baseline.mjs';
import {composeApprovedGeneralBaseline as v4}from'../approved-general-baseline-composition-v4-real-factory/compose-approved-general-baseline.mjs';
import S from'../approved-general-baseline-composition-v3/INPUT_PROJECTED_RUNTIME_STANDARD.json'with{type:'json'};
import R from'../approved-general-baseline-composition-v3/reminders/REMINDER_BASELINE_BINDINGS.json'with{type:'json'};
import L from'../approved-general-baseline-composition-v3/selected-local-skills/ARTIFACT_BINDINGS.json'with{type:'json'};
import M from'../approved-general-baseline-composition-v3/multipart-pdf/ARTIFACT_BINDINGS.json'with{type:'json'};
import B from'./FIXED_THREE_GUIDE_BINDINGS.json'with{type:'json'};
import TWO from'../translation-video-batch-v1/TRANSLATION_VIDEO_BINDINGS.json'with{type:'json'};
const now=()=>{};
const hash=x=>createHash('sha256').update(x).digest('hex');
function fixture(person,sender){const id='personal-'+hash('crays.personal-agent.assignment.v1\n'+person).slice(0,48),runtime='/var/lib/crays-personal-agents/'+hash('crays.personal-agent.person-namespace.v1\n'+person)+'/'+id,account='fixture-business-'+person,policy={profile:'full',allow:[...S.descriptor.tools],deny:[],fs:{workspaceOnly:true}},channel={enabled:true,dmPolicy:'allowlist',groupPolicy:'disabled',configWrites:false,allowFrom:[sender]};return {context:{canonicalPersonId:person,agentId:id,runtime},base:{tools:structuredClone(policy),agents:{defaults:{timeoutSeconds:120,heartbeat:{every:'0m',target:'none'}},entries:{[id]:{workspace:runtime+'/workspace',agentDir:runtime+'/agents/'+id+'/agent',tools:structuredClone(policy),skills:[...S.descriptor.skills],heartbeat:{every:'0m',target:'none'},model:{primary:'openai/fixture-own-model',fallbacks:[]}}}},skills:{load:{extraDirs:[...L.artifacts.map(x=>x.extraDir)]},entries:Object.fromEntries(S.descriptor.skills.map(x=>[x,{enabled:true}]))},plugins:{allow:[...R.pluginAllow],load:{paths:[M.oldPluginRoot]},entries:Object.fromEntries(R.pluginAllow.map(x=>[x,{enabled:true}]))},auth:{profiles:{['own-'+person]:{provider:'openai',mode:'oauth'}},order:{openai:['own-'+person]}},channels:{whatsapp:{...channel,accounts:{[account]:structuredClone(channel)}}},bindings:[{agentId:id,match:{channel:'whatsapp',accountId:account}}],commands:{ownerAllowFrom:['whatsapp:'+sender]},cron:{enabled:false},hooks:{enabled:false}}};}

function unconnected(x){delete x.base.channels;delete x.base.bindings;delete x.base.commands;return x;}
for(const mode of ['own-wa','app-only','telegram'])test('two real V4 synthetic Core lineages: '+mode,()=>{
 const outputs=[];
 for(const [person,sender]of [['v5-alice','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__'],['v5-bob','__CRAYS_PRIVATE_LITERAL_1d0816813e0c2d328e8ed7ab__']]){
  const x=fixture(person,sender);if(mode!=='own-wa')unconnected(x);if(mode==='telegram'){x.base.channels={telegram:{enabled:true,accounts:{['own-'+person]:{enabled:true}}}};x.base.bindings=[{agentId:x.context.agentId,match:{channel:'telegram',accountId:'own-'+person}}];}
  const before=JSON.stringify(x.base),old=v4(x.base,x.context),out=compose(x.base,x.context,{assertInvocationCurrent:now}),c=out.candidateConfig,a=c.agents.entries[x.context.agentId];
  assert.equal(JSON.stringify(x.base),before);assert.equal(out.toolCount,mode==='own-wa'?30:29);assert.equal(out.instructionCount,32);assert.equal(c.tools.allow.length,out.toolCount);assert.deepEqual(a.skills,[...B.baselineInstructionNames,B.weather.name,...TWO.artifacts.map(a=>a.name)]);assert.equal(out.nativeRegistryLoaded,false);assert.equal(out.defaultFactorySwitched,false);assert.equal(out.runtimeStarted,false);assert.equal(out.weatherDefaultRuntimeQualified,false);
  for(const k of Object.keys(old.candidateConfig))if(k!=='agents'&&k!=='skills')assert.deepEqual(c[k],old.candidateConfig[k]);
  for(const k of ['auth','channels','bindings','commands','hooks'])assert.strictEqual(c[k],x.base[k]);
  assert.deepEqual(c.agents.defaults,old.candidateConfig.agents.defaults);assert.equal(c.agents.defaults.timeoutSeconds,300);assert.equal(c.agents.defaults.heartbeat.every,'0m');assert.strictEqual(a.model,x.base.agents.entries[x.context.agentId].model);
  for(const art of [B.weather,...TWO.artifacts])assert.equal(c.skills.load.extraDirs.filter(d=>d===art.extraDir).length,1);
  if(mode!=='own-wa'){assert(!c.tools.allow.includes('automations'));assert.equal(c.cron.enabled,false);assert.equal(out.pendingBranches.length,1);assert.equal(out.targetInstructionNames.length,32);assert(!c.channels?.whatsapp);}
  else assert.equal(c.plugins.entries['crays-personal-reminder-policy'].config.bindings[0].senderId,sender);
  assert(!JSON.stringify(c).includes('crays-agent-thorben'));assert(!JSON.stringify(c).includes('/run/crays-owner-tools-whatsapp-live'));outputs.push({person,x,c});
 }
 assert.notEqual(outputs[0].x.context.agentId,outputs[1].x.context.agentId);assert.notEqual(outputs[0].c.agents.entries[outputs[0].x.context.agentId].agentDir,outputs[1].c.agents.entries[outputs[1].x.context.agentId].agentDir);assert(!JSON.stringify(outputs[0].c).includes(outputs[1].x.context.agentId));
});
test('fixed3 preserves exact V4 policies by reference and is idempotent',()=>{const x=unconnected(fixture('direct','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__')),b=v4(x.base,x.context).candidateConfig,before=JSON.stringify(b);b.agents.entries.unselected={skills:['retained']};const out=fixed(b,{agentId:x.context.agentId,assertInvocationCurrent:now});for(const k of Object.keys(b))if(k!=='skills'&&k!=='agents')assert.strictEqual(out[k],b[k]);assert.strictEqual(out.agents.entries.unselected,b.agents.entries.unselected);assert.strictEqual(out.agents.defaults,b.agents.defaults);for(const k of Object.keys(b.agents.entries[x.context.agentId]))if(k!=='skills')assert.strictEqual(out.agents.entries[x.context.agentId][k],b.agents.entries[x.context.agentId][k]);assert.strictEqual(fixed(out,{agentId:x.context.agentId,assertInvocationCurrent:now}),out);delete b.agents.entries.unselected;assert.equal(JSON.stringify(b),before);});
test('weather guide is exact existing published bytes, not owner-account composition',()=>{for(const row of [B.weather.publishedGuide,B.weather.publishedManifest]){const bytes=fs.readFileSync(row.path);assert.equal(bytes.length,row.bytes);assert.equal(hash(bytes),row.sha256);}assert.equal(B.weather.publishedGuide.sha256,'a4cb0c8aca8109c536d04428810d52b42202545c80e6f6d52e46b7cb20917468');});
test('wrong lineage, route and baseline remain denied by unchanged V4',()=>{for(const edit of[x=>x.context.canonicalPersonId='foreign',x=>x.context.runtime+='/foreign',x=>x.base.bindings[0].agentId='foreign',x=>x.base.tools.allow.push('exec'),x=>x.base.agents.entries[x.context.agentId].skills.reverse()]){const x=fixture('denied','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__');edit(x);assert.throws(()=>compose(x.base,x.context,{assertInvocationCurrent:now}));}});
test('fixed3 rejects partial/replaced/disabled/extra profiles rather than granting extras',()=>{for(const edit of[b=>b.agents.entries[Object.keys(b.agents.entries)[0]].skills.push(B.weather.name),b=>b.skills.entries[B.weather.name]={enabled:true},b=>b.skills.load.extraDirs.push(B.weather.extraDir),b=>b.skills.load.extraDirs.push(B.weather.extraDir.replace(B.weather.root,'/opt/crays/openclaw/skill-artifacts/crays-weather-public/alien')),b=>b.agents.entries[Object.keys(b.agents.entries)[0]].skills.push('alien')]){const x=unconnected(fixture('fixed-denied','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__')),b=v4(x.base,x.context).candidateConfig;edit(b);assert.throws(()=>fixed(b,{agentId:x.context.agentId,assertInvocationCurrent:now}));}const x=unconnected(fixture('disabled','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__'));const b=compose(x.base,x.context,{assertInvocationCurrent:now}).candidateConfig;b.skills.entries[B.weather.name].enabled=false;assert.throws(()=>fixed(b,{agentId:x.context.agentId,assertInvocationCurrent:now}));});
test('async/Promise/thenable guards denied and current revocation is consequential',async()=>{let dispatch=0;for(const check of [async()=>{},()=>Promise.resolve(),()=>Promise.reject(Error('synthetic')),()=>({then(){dispatch++;}}),()=>true]){const x=fixture('guard','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__');assert.throws(()=>compose(x.base,x.context,{assertInvocationCurrent:check}));}await new Promise(r=>setImmediate(r));assert.equal(dispatch,0);let calls=0;const x=fixture('revoked','__CRAYS_PRIVATE_LITERAL_0c60f8e4eb82a7de1268df81__'),before=JSON.stringify(x.base);assert.throws(()=>compose(x.base,x.context,{assertInvocationCurrent:()=>{if(++calls===4)throw Error('REVOKED');}}),/REVOKED/);assert.equal(JSON.stringify(x.base),before);});
