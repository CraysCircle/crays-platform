function fixture(person,sender){const id='personal-'+hash('crays.personal-agent.assignment.v1\n'+person).slice(0,48),runtime='/var/lib/crays-personal-agents/'+hash('crays.personal-agent.person-namespace.v1\n'+person)+'/'+id,account='fixture-business-'+person,policy={profile:'full',allow:[...S.descriptor.tools],deny:[],fs:{workspaceOnly:true}},channel={enabled:true,dmPolicy:'allowlist',groupPolicy:'disabled',configWrites:false,allowFrom:[sender]};return {context:{canonicalPersonId:person,agentId:id,runtime},base:{tools:structuredClone(policy),agents:{defaults:{timeoutSeconds:120,heartbeat:{every:'0m',target:'none'}},entries:{[id]:{workspace:runtime+'/workspace',agentDir:runtime+'/agents/'+id+'/agent',tools:structuredClone(policy),skills:[...S.descriptor.skills],heartbeat:{every:'0m',target:'none'},model:{primary:'openai/fixture-own-model',fallbacks:[]}}}},skills:{load:{extraDirs:[...L.artifacts.map(x=>x.extraDir)]},entries:Object.fromEntries(S.descriptor.skills.map(x=>[x,{enabled:true}]))},plugins:{allow:[...R.pluginAllow],load:{paths:[M.oldPluginRoot]},entries:Object.fromEntries(R.pluginAllow.map(x=>[x,{enabled:true}]))},auth:{profiles:{['own-'+person]:{provider:'openai',mode:'oauth'}},order:{openai:['own-'+person]}},channels:{whatsapp:{...channel,accounts:{[account]:structuredClone(channel)}}},bindings:[{agentId:id,match:{channel:'whatsapp',accountId:account}}],commands:{ownerAllowFrom:['whatsapp:'+sender]},cron:{enabled:false},hooks:{enabled:false}}};}

const hash=x=>createHash('sha256').update(x).digest('hex');
const encode=x=>Array.isArray(x)?'['+x.map(encode).join(',')+']':x!==null&&typeof x==='object'?'{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+encode(x[k])).join(',')+'}':JSON.stringify(x);
function proposal(){const x=fixture('adapter-synthetic-person','__CRAYS_PRIVATE_LITERAL_44c160f8e0c1cc87875c5d1f__');delete x.base.channels;delete x.base.bindings;delete x.base.commands;x.base.skills.load.extraDirs=INPUTCAT.skills.map(s=>s.root+'/skills');x.base.plugins.load.paths=INPUTCAT.plugins.map(p=>p.root);const c=original(x.base,x.context).candidateConfig;
 // Synthetic unadmitted catalogue exercises only deterministic binding, never artifact verification.
 const plugins=c.plugins.load.paths.map(root=>({pluginId:root.includes('/expediagroup-expedia-openclaw-runtime/')?'expedia-openclaw':root.split('/').at(-2),root}));
 const aliases=[],skills=c.agents.entries[x.context.agentId].skills.filter(n=>n!=='weather').map((name,i)=>{const dir=c.skills.load.extraDirs[i],root=dir.startsWith(x.context.runtime+'/code/')?'/opt/crays/openclaw/synthetic-unadmitted-instruction/'+i:dir.slice(0,-7);if(dir.startsWith(x.context.runtime+'/code/'))aliases.push({runtimePath:dir,artifactPath:root+'/skills'});return {name,skillId:name,root};});
 // Match by path order rather than capability order: name/path pairing is not an admission proof.
 const descriptor={tools:c.tools.allow,skills:c.agents.entries[x.context.agentId].skills,plugins:plugins.map(p=>({id:p.pluginId}))};
 return {x,projection:{baseProjectedSha256:S.sha256,standard:{descriptor,sha256:hash(encode(descriptor))},catalog:{packageSha256:hash(encode(descriptor)),plugins,skills},instructionAliases:aliases}};
}
test('missing final catalogue fails closed in pure and async seam before artifact reads',async()=>{assert.throws(()=>compose({}, {}, null),/PENDING_GENERAL_BASELINE_CATALOGUE/);await assert.rejects(prepare({}, {}, null),/PENDING_GENERAL_BASELINE_CATALOGUE/);});
test('descriptor digest cannot be asserted by external catalogue',()=>{const {x,projection:p}=proposal();p.standard.sha256='0'.repeat(64);assert.throws(()=>compose(x.base,x.context,p),/GENERAL_DESCRIPTOR_DIGEST_MISMATCH/);});
test('synthetic final29/29 projection composes without authority or default switch',()=>{const {x,projection:p}=proposal();const out=compose(x.base,x.context,p);assert.equal(out.toolCount,29);assert.equal(out.skillCount,29);assert.equal(out.runtimeStarted,false);assert.equal(out.nativeToolRegistryLoaded,false);assert.equal(out.nativeReadonlyAliasesVerified,false);assert.equal(out.pendingBranches.length,1);assert.strictEqual(out.config.auth,x.base.auth);});
test('unverified plugin-root omission cannot bypass final catalogue coverage',()=>{const {x,projection:p}=proposal();p.catalog.plugins.pop();assert.throws(()=>compose(x.base,x.context,p),/EVERY_APPROVED_GENERAL_PLUGIN_MUST_BE_PRESENT/);});
test('missing or foreign runtime instruction aliases fail closed',()=>{for(const change of[p=>p.instructionAliases.pop(),p=>p.instructionAliases[0].runtimePath='/var/lib/foreign/code/research/skills']){const {x,projection:p}=proposal();change(p);assert.throws(()=>compose(x.base,x.context,p));}});

test('omitting a base plugin from both load paths and catalogue is denied',()=>{const {x,projection:p}=proposal();const removed=x.base.plugins.load.paths.shift();p.catalog.plugins=p.catalog.plugins.filter(a=>a.root!==removed);p.standard.descriptor.plugins=p.standard.descriptor.plugins.filter(a=>a.id!==removed.split('/').at(-2));p.standard.sha256=hash(encode(p.standard.descriptor));p.catalog.packageSha256=p.standard.sha256;assert.throws(()=>compose(x.base,x.context,p),/EVERY_APPROVED_GENERAL_PLUGIN_MUST_BE_PRESENT/);});
