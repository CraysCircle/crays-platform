 const add=value=>({...value,allow:[...value.allow,TOOL]});
 const cfg={...base,tools:add(base.tools),agents:{...base.agents,entries:{[ID]:{...agent,tools:add(agent.tools),skills:[...agent.skills,PLUGIN]}}},plugins:{...base.plugins,allow:[...base.plugins.allow,PLUGIN],load:{...base.plugins.load,paths:[...base.plugins.load.paths,ARTIFACTS.exportPluginRoot]},entries:{...base.plugins.entries,[PLUGIN]:{enabled:true}}},skills:{...base.skills,load:{...base.skills.load,extraDirs:[...base.skills.load.extraDirs,ARTIFACTS.exportSkillRoot+'/skills']},entries:{...base.skills.entries,[PLUGIN]:{enabled:true}}}};
 for(const [key,value]of Object.entries(base))if(!['agents','tools','plugins','skills'].includes(key))assert.strictEqual(cfg[key],value);
 assert.strictEqual(cfg.agents.defaults,base.agents.defaults);assert.strictEqual(cfg.agents.entries[ID].model,agent.model);
 for(const [key,value]of Object.entries(agent))if(!['tools','skills'].includes(key))assert.strictEqual(cfg.agents.entries[ID][key],value);
