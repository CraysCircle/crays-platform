 assert.deepEqual(base.plugins.allow,PLUGINS);assert.equal(new Set(base.plugins.load.paths).size,base.plugins.load.paths.length);
 assert.deepEqual(base.plugins.load.paths.filter(p=>p.startsWith('/opt/crays/openclaw/plugin-artifacts/')),[...ARTIFACTS.existingPluginRoots,ARTIFACTS.noticePluginRoot]);
 for(const id of PLUGINS)assert.equal(base.plugins.entries[id].enabled,true);
 assert.deepEqual(base.plugins.entries[NOTICE],{enabled:true,hooks:{allowConversationAccess:true},config:{bindings:[{accountId:ACCOUNT,recipient:OWNER,locale:'de'}]}});
 assert.equal(base.channels.whatsapp.enabled,true);assert.equal(base.channels.whatsapp.dmPolicy,'allowlist');assert.equal(base.channels.whatsapp.groupPolicy,'disabled');assert.equal(base.channels.whatsapp.configWrites,false);
 assert.deepEqual(base.channels.whatsapp.allowFrom,[OWNER]);assert.deepEqual(base.commands.ownerAllowFrom,['whatsapp:'+OWNER]);
 assert.deepEqual(Object.keys(base.channels.whatsapp.accounts),[ACCOUNT]);const account=base.channels.whatsapp.accounts[ACCOUNT];assert.equal(account.enabled,true);assert.equal(account.dmPolicy,'allowlist');assert.equal(account.groupPolicy,'disabled');assert.equal(account.configWrites,false);assert.deepEqual(account.allowFrom,[OWNER]);
 assert.deepEqual(base.bindings,[{agentId:ID,match:{channel:'whatsapp',accountId:ACCOUNT}}]);
