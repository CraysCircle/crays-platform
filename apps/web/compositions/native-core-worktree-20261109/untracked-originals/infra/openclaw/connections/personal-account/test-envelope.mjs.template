import test from'node:test';import assert from'node:assert/strict';import{randomBytes}from'node:crypto';import{createEnvelopeCodec}from'./envelope.mjs';
function setup(){const keys=new Map([['keyref:synthetic/v1',Buffer.alloc(32,11)],['keyref:synthetic/v2',Buffer.alloc(32,23)]]);let current='keyref:synthetic/v1';return{keys,rotate(){current='keyref:synthetic/v2';},codec:createEnvelopeCodec({keys:{currentKeyRef:async()=>current,withKey:async(ref,f)=>{assert(keys.has(ref));return f(keys.get(ref));}}})};}
const context={accountId:'synthetic-account',canonicalPersonId:'SQL/text-not-a-path',provider:'google',purpose:'oauth-credential',resourceId:'cv_synthetic',resourceVersion:'1',connectionHandle:'cn_synthetic'};
test('actual AES256GCM envelope hides synthetic credential and roundtrips only exact owner context',async()=>{const{codec}=setup(),secret={accessToken:'__CRAYS_PRIVATE_LITERAL_f438faf78481af324c6257e2__',refreshToken:'__CRAYS_PRIVATE_LITERAL_ecd8b960ea18113b81f727da__'};const e=await codec.encrypt(secret,context);assert(!JSON.stringify(e).includes(secret.accessToken));assert.deepEqual(await codec.decrypt(e,context),secret);});
test('same plaintext has random independent nonce and ciphertext',async()=>{const{codec}=setup(),a=await codec.encrypt({x:1},context),b=await codec.encrypt({x:1},context);assert.notEqual(a.nonce,b.nonce);assert.notEqual(a.ciphertext,b.ciphertext);});
test('cross-person account provider purpose resource and revision AAD tampering deny',async()=>{const{codec}=setup(),e=await codec.encrypt({token:'synthetic'},context);for(const k of Object.keys(context)){await assert.rejects(codec.decrypt(e,{...context,[k]:k==='resourceVersion'?'2':'foreign'}),/VAULT_ENVELOPE_DENIED/);}});
test('ciphertext tag nonce and key reference corruption fail authenticated decryption',async()=>{const{codec}=setup(),e=await codec.encrypt({token:'synthetic'},context);for(const key of['ciphertext','tag','nonce']){const bytes=Buffer.from(e[key],'base64url');bytes[0]^=1;await assert.rejects(codec.decrypt({...e,[key]:bytes.toString('base64url')},context),/VAULT_ENVELOPE_DENIED/);}await assert.rejects(codec.decrypt({...e,keyRef:'keyref:synthetic/v2'},context),/VAULT_ENVELOPE_DENIED/);});
test('versioned rotation keeps old key readable and new envelope references current key',async()=>{const s=setup(),one=await s.codec.encrypt({x:7},context);s.rotate();const two=await s.codec.encrypt(await s.codec.decrypt(one,context),{...context,resourceVersion:'2'});assert.equal(one.keyRef,'keyref:synthetic/v1');assert.equal(two.keyRef,'keyref:synthetic/v2');assert.deepEqual(await s.codec.decrypt(two,{...context,resourceVersion:'2'}),{x:7});assert(s.keys.get('keyref:synthetic/v1').every(x=>x===11),'host custody key must not be zeroed');});
test('missing custody invalid key lengths formats and oversized secrets fail closed',async()=>{assert.throws(()=>createEnvelopeCodec({}),/KEY_CUSTODY_REQUIRED/);const s=setup();await assert.rejects(s.codec.encrypt({x:'x'.repeat(65537)},context),/VAULT_ENVELOPE_DENIED/);await assert.rejects(s.codec.decrypt({format:'other'},context),/VAULT_ENVELOPE_DENIED/);const short=createEnvelopeCodec({keys:{currentKeyRef:async()=> 'keyref:synthetic/x',withKey:async(r,f)=>f(randomBytes(16))}});await assert.rejects(short.encrypt({},context),/VAULT_ENVELOPE_DENIED/);});
