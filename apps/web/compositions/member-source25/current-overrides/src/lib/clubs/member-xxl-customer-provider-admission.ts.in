/** This is a reviewed same-customer TEST overlay, never a generic expiry bypass.
 * Original credentials, finite records and seller/payment snapshots remain intact.
 * Any metadata/config drift or revocation fails closed on the next operation. */
export function readExactXxlCustomerProviderAdmission(env:Env=process.env):Json|null{
 const flag=env.CRAYS_MEMBER_XXL_CUSTOMER_PROVIDER_ADMISSION_SHA256,path=env.CRAYS_MEMBER_XXL_CUSTOMER_PROVIDER_ADMISSION_PATH;
 if(flag===undefined&&path===undefined)return null;
 if(flag!==XXL_PROVIDER_ADMISSION_SHA256||path!==XXL_PROVIDER_ADMISSION_PATH||env.NODE_ENV!=="production"||env.VERCEL_ENV!=="preview"||env.AUTH0_CLUBS_BASE_URL!=="http://localhost:8990"||env.AUTH0_CLUBS_CLIENT_ID!=="gVA7ECS4WDjweQjtjZFbyNoxaVXnH2vl"||!["login.crays.pro","https://login.crays.pro","https://login.crays.pro/"].includes(env.AUTH0_CLUBS_DOMAIN??"")||env.CRAYS_CORE_ORIGINAL_MEMBER_RPC_XL_TARGET!=="xxl-member-core-test"||env.CRAYS_MEMBER_NATIVE_BACKEND!==undefined||env.CRAYS_MEMBER_NATIVE_RPC_SLOT!==undefined||env.CRAYS_MEMBER_NATIVE_PROVIDER_BINDING!==undefined||env.CRAYS_MEMBER_XXL_NO_EXPIRY_RUNTIME_APPROVAL!=="8d0d806f5e5dd5c7429a76b8d131da96a29fd785e815e9837c378e8893739684")denied();
 const bytes=protectedBytes(path);if(sha(bytes)!==XXL_PROVIDER_ADMISSION_SHA256)denied();const a:Json=JSON.parse(bytes.toString("utf8"));
 if(a.schema!=="crays.member.xxl-customer-provider-admission.v2"||a.admissionId!=="member-xxl-customer-provider-noexpiry-20261028-001"||a.state!=="active"||a.revokedAt!==null||a.expiresAt!==null||a.accountId!==ACCOUNT||a.testOnly!==true||a.liveMoney!==false||a.productionActivationAllowed!==false||a.environment!=="existing-xxl-test"||a.sdk?.subjectSha256!=="__CRAYS_PROTECTED_MEMBER_TEST_SUBJECT_SHA256__")denied();
 for(const [name,pin]of Object.entries(SOURCE_HASHES)){const entry=a.originalFiles?.[name];if(entry?.path!==BASE+name||entry.sha256!==pin||entry.uid!==1000||entry.mode!=="0o600"||sha(protectedBytes(BASE+name))!==pin)denied();}
 return a;
}
/** Expected account is resolved by the original current SDK/Core actor first. */
export function projectExactXxlCommerceProvider(configText:string,decisionText:string,expectedAccountId:string,env:Env=process.env):{cfg:Json;decision:Json}|null{
 const a=readExactXxlCustomerProviderAdmission(env);if(!a)return null;
 if(expectedAccountId!==ACCOUNT||sha(configText)!==SOURCE_HASHES["commerce-provider.private.json"]||sha(decisionText)!==SOURCE_HASHES["TEST_COMMERCE_BINDINGS_NATIVE.json"])denied();
 const cfg:Json=JSON.parse(configText),decision:Json=JSON.parse(decisionText),authority=cfg.authority;
 if(authority?.accountId!==ACCOUNT||authority.testOnly!==true||authority.liveMoney!==false||authority.productionActivationAllowed!==false||authority.providerInstance!==a.vendure.instance||authority.providerImage!==a.vendure.imageId||authority.providerDatabase!==a.vendure.database||authority.customerId!==a.vendure.customerId||authority.userId!==a.vendure.userId||String(authority.vendureSellerId)!==a.vendure.sellerId||String(authority.vendureChannelId)!==a.vendure.channelId||String(authority.primaryStockLocationId)!==a.vendure.stockLocationId||sha(cfg.channelToken)!==a.vendure.channelTokenSha256||decision.customerCurrency!=="USD"||decision.testOnly!==true||decision.liveMoney!==false||decision.productionActivationAllowed!==false||decision.nativePaymentHandler!=="crays-test-payment"||decision.nativeSellerBindingVersion!==a.vendure.nativeSellerBindingVersion)denied();
 for(const name of ["deploymentCellId","operatorTenantId","operatorLegalEntityId","storeId","storeOperatorAssignmentId","assignmentVersion","bindingId","bindingVersion"])if(authority[name]!==a.vendure[name])denied();
 return {cfg:{...cfg,shopEndpoint:a.vendure.shopEndpoint,adminEndpoint:a.vendure.adminEndpoint},decision};
}
export function projectExactXxlErpProvider(configText:string,expectedAccountId:string,env:Env=process.env):{config:Json}|null{
 const a=readExactXxlCustomerProviderAdmission(env);if(!a)return null;
 if(expectedAccountId!==ACCOUNT||sha(configText)!==SOURCE_HASHES["erp-runtime.private.json"])denied();const config:Json=JSON.parse(configText);
 if(config.accountId!==ACCOUNT||config.testOnly!==true||config.productionActivationAllowed!==false||config.host!==a.erp.host||config.user!==a.erp.user||config.company!==a.erp.company||config.currency!=="USD")denied();
 return {config:{...config,endpoint:a.erp.endpoint}};
}
