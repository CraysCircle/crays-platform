import "server-only";
import {member073DocumentTarget} from "./member073-native-provider-binding";
import {createHash} from "node:crypto";
import {readFile,lstat} from "node:fs/promises";
import {z} from "zod";
import {memberSelfPorts} from "@/graphql/member-self/member-self-runtime-ports";
import {queryMemberDemoDocuments} from "@/db/core-member-demo-documents-runtime";
import {createMemberNextcloudDocument,readMemberNextcloudDocument} from "./member-nextcloud-document-provider";
import {memberDemoDocumentsInputSchema,memberDemoDocumentsReadSchema} from "@/lib/clubs/member-demo-document-contract";

const OWN_ACCOUNT="__CRAYS_PROTECTED_MEMBER_TEST_ACCOUNT_ID__";
const OWN_PRINCIPAL_PATH="/srv/crays/dev-state/member-area-screen1-20261006/member-nextcloud-native-20261012/member-document-principal.private.json";
const PROVIDER_ID="322f0ad845156c4e42e3a9d8fbe07140a5a2f412cef23f222c5d7330263f1fa8";
const MAX_BYTES=10*1024*1024;
const hash=(bytes:Uint8Array|string)=>createHash("sha256").update(bytes).digest("hex");
const sha=z.string().regex(/^[a-f0-9]{64}$/);
const metadata=z.object({contractVersion:z.literal("1.0.0"),idempotencyKey:z.string().min(16).max(100),kind:z.enum(["travel","stay","membership","general"]),title:z.string().trim().min(1).max(300),sourceRecordId:z.string().regex(/^map_member_test_stay_[a-f0-9]{32}$/).nullable(),sourceVersion:z.number().int().positive().nullable(),sourceRowSha256:sha.nullable()}).strict();
const principalSchema=z.object({purpose:z.literal("member_owned_test_documents"),accountId:z.literal(OWN_ACCOUNT),username:z.literal("crays-member-docs-1072e7ba1a670cca6961992a"),password:z.string().min(32),providerInstanceId:z.literal(PROVIDER_ID),createdByRequestId:z.literal("MEMBER-NEXTCLOUD-OWN-PRINCIPAL-20261012-001"),virtualHost:z.literal("localhost"),origin:z.string().url()}).strict();
type Sdk=NonNullable<Awaited<ReturnType<typeof memberSelfPorts.resolveCurrentSdk>>>;
async function current(request:Request){const sdk=await memberSelfPorts.resolveCurrentSdk(request);if(!sdk||sdk.expectedAccountId!==OWN_ACCOUNT)throw Error("DOCUMENT_SDK_REQUIRED");return sdk;}
async function unchanged(request:Request,before:Sdk){const after=await current(request);if(after.issuer!==before.issuer||after.subject!==before.subject||after.serverConfiguredClientId!==before.serverConfiguredClientId||after.expectedAccountId!==before.expectedAccountId)throw Error("DOCUMENT_SDK_CHANGED");}
function args(sdk:Sdk){return [sdk.issuer,sdk.subject,hash(sdk.serverConfiguredClientId)];}
async function principal(){
 if(process.env.CRAYS_MEMBER_DOCUMENT_PROVIDER_TARGET!==member073DocumentTarget()||process.env.CRAYS_MEMBER_DOCUMENT_PRINCIPAL_PATH!==OWN_PRINCIPAL_PATH)throw Error("DOCUMENT_NATIVE_PROVIDER_NOT_ADMITTED");
 const info=await lstat(OWN_PRINCIPAL_PATH);if((info.mode&0o777)!==0o600||!info.isFile()||info.isSymbolicLink()||info.size>8192||typeof process.getuid==="function"&&info.uid!==process.getuid())throw Error("DOCUMENT_PRINCIPAL_CUSTODY_INVALID");
 return principalSchema.parse(JSON.parse(await readFile(OWN_PRINCIPAL_PATH,"utf8")));
}
function response(value:unknown,status=200){return Response.json(value,{status,headers:{"Cache-Control":"private, no-store"}});}
function sameOrigin(request:Request){try{const raw=request.headers.get("origin"),host=request.headers.get("host");if(!raw||!host)return false;const origin=new URL(raw);return ["http:","https:"].includes(origin.protocol)&&!origin.username&&!origin.password&&origin.origin===raw&&origin.host===host;}catch{return false;}}
async function boundedBody(request:Request){
 if(!request.body)throw Error("DOCUMENT_FILE_MISSING");
 const limit=MAX_BYTES+64*1024;const announced=Number(request.headers.get("content-length"));if(Number.isFinite(announced)&&announced>limit)throw Error("DOCUMENT_TOO_LARGE");
 const reader=request.body.getReader();const chunks:Uint8Array[]=[];let size=0;
 try{while(true){const row=await reader.read();if(row.done)break;size+=row.value.byteLength;if(size>limit){await reader.cancel();throw Error("DOCUMENT_TOO_LARGE");}chunks.push(row.value);}}finally{reader.releaseLock();}
 return Buffer.concat(chunks);
}

/** File transport is same-origin; Core reservation/finish is the sole metadata authority. */
export async function handleNativeMemberDocumentUpload(request:Request){
 let sdk:Sdk|undefined,reservation:{documentId:string;state:string;coreReservationSha256:string;sourceRecordId:string|null}|undefined;
 try{
  if(request.method!=="POST"||!sameOrigin(request)||!request.headers.get("content-type")?.startsWith("multipart/form-data;"))return response({error:"DOCUMENT_REQUEST_INVALID"},400);
  sdk=await current(request);
  const form=await new Request(request.url,{method:"POST",headers:{"Content-Type":request.headers.get("content-type")!},body:new Uint8Array(await boundedBody(request)).buffer}).formData();
  if([...form.keys()].sort().join(",")!=="file,metadata"||form.getAll("file").length!==1||form.getAll("metadata").length!==1)throw Error("DOCUMENT_INPUT_INVALID");
  const raw=form.get("metadata"),file=form.get("file");if(typeof raw!=="string"||raw.length>3000||!(file instanceof File)||file.size<8||file.size>MAX_BYTES||file.name.length>180||/[/\\\r\n]/.test(file.name))throw Error("DOCUMENT_FILE_INVALID");
  const input=metadata.parse(JSON.parse(raw));const mime=z.enum(["application/pdf","image/png","image/jpeg"]).parse(file.type);
  const bytes=new Uint8Array(await file.arrayBuffer());const contentSha256=hash(bytes);
  const validSignature=mime==="application/pdf"?Buffer.from(bytes.slice(0,5)).toString()==="%PDF-":mime==="image/png"?Buffer.from(bytes.slice(0,8)).equals(Buffer.from([137,80,78,71,13,10,26,10])):bytes[0]===255&&bytes[1]===216&&bytes[2]===255;
  if(!validSignature)throw Error("DOCUMENT_CONTENT_SIGNATURE_INVALID");
  await unchanged(request,sdk);
  const nativePrincipal=await principal();
  const payload={...input,originalFilename:file.name,mimeType:mime,bytes:bytes.byteLength,contentSha256};
  const out=await queryMemberDemoDocuments("prepare",[...args(sdk),JSON.stringify(payload)]);
  if(out.schema!=="crays.member.document-reservation.v1"||out.accountId!==sdk.expectedAccountId||out.contentSha256!==contentSha256||out.bytes!==bytes.byteLength||out.mimeType!==mime||out.testOnly!==true)throw Error("DOCUMENT_CORE_SCOPE_INVALID");
  reservation=out;
  const authority={accountId:sdk.expectedAccountId,documentId:out.documentId,principalUsername:nativePrincipal.username,sourceRecordId:out.sourceRecordId,coreReservationSha256:out.coreReservationSha256,testOnly:true as const};
  await unchanged(request,sdk);
  let receipt;
  if(out.state==="reserved")receipt=await createMemberNextcloudDocument(nativePrincipal,authority,{bytes,mimeType:mime,contentSha256});
  else if(out.state==="ready"||out.state==="unknown")receipt=(await readMemberNextcloudDocument(nativePrincipal,authority)).receipt;
  else throw Error("DOCUMENT_CORE_RESERVATION_REJECTED");
  if(receipt.contentSha256!==contentSha256||receipt.bytes!==bytes.byteLength||receipt.mimeType!==mime)throw Error("DOCUMENT_NATIVE_CONTENT_CONFLICT");
  await unchanged(request,sdk);
  const finish=await queryMemberDemoDocuments("finish",[...args(sdk),out.documentId,JSON.stringify(receipt),"ready"]);
  await unchanged(request,sdk);
  if(finish.accountId!==sdk.expectedAccountId||finish.documentId!==out.documentId||finish.state!=="ready"||finish.providerReadbackVerified!==true)throw Error("DOCUMENT_FINISH_NOT_ACKNOWLEDGED");
  return response({schema:finish.schema,documentId:finish.documentId,version:finish.version,state:"ready",testOnly:true},201);
 }catch{
  if(sdk&&reservation&&reservation.state==="reserved"){
   try{await unchanged(request,sdk);await queryMemberDemoDocuments("finish",[...args(sdk),reservation.documentId,null,"unknown"]);}catch{/* Core cannot publish a revoked or changed actor; retain original reservation. */}
  }
  return response({error:"DOCUMENT_UPDATE_UNCONFIRMED",message:"We couldn’t confirm your file was shared. Refresh your documents before trying again."},409);
 }
}

/** Fresh SDK + Core object ACL + original native SHA/ETag before any private bytes leave the BFF. */
export async function handleNativeMemberDocumentFile(request:Request,documentId:string){
 try{
  if(request.method!=="GET"||!/^doc_member_[a-f0-9]{32}$/.test(documentId))return response({error:"DOCUMENT_REQUEST_INVALID"},400);
  const sdk=await current(request);const grant=await queryMemberDemoDocuments("authorize",[...args(sdk),documentId]);
  if(grant.schema!=="crays.member.document-file-authority.v1"||grant.accountId!==sdk.expectedAccountId||grant.documentId!==documentId||grant.testOnly!==true||grant.providerInstanceId!==PROVIDER_ID)throw Error("DOCUMENT_FILE_SCOPE_INVALID");
  const nativePrincipal=await principal();const authority={accountId:sdk.expectedAccountId,documentId,principalUsername:grant.principalUsername,sourceRecordId:grant.sourceRecordId,coreReservationSha256:grant.coreReservationSha256,testOnly:true as const};
  const observed=await readMemberNextcloudDocument(nativePrincipal,authority);
  if(observed.receipt.contentSha256!==grant.contentSha256||observed.receipt.providerVersionReference!==grant.providerVersionReference||observed.receipt.bytes!==grant.bytes||observed.receipt.mimeType!==grant.mimeType||observed.receipt.providerMimeType!==grant.providerMimeType)throw Error("DOCUMENT_NATIVE_REVISION_CHANGED");
  await unchanged(request,sdk);const after=await queryMemberDemoDocuments("authorize",[...args(sdk),documentId]);
  if(JSON.stringify(after)!==JSON.stringify(grant))throw Error("DOCUMENT_FILE_AUTHORITY_CHANGED");
  await unchanged(request,sdk);
  const inline=new URL(request.url).searchParams.get("inline")==="1";
  return new Response(new Uint8Array(observed.bytes).buffer,{headers:{"Content-Type":grant.mimeType,"Content-Length":String(observed.bytes.byteLength),"Content-Disposition":`${inline?"inline":"attachment"}; filename*=UTF-8''${encodeURIComponent(grant.originalFilename)}`,"Cache-Control":"private, no-store","X-Content-Type-Options":"nosniff","Content-Security-Policy":"sandbox; default-src 'none'"}});
 }catch{return response({error:"DOCUMENT_FILE_UNAVAILABLE",message:"We couldn’t safely open this document. Please refresh and try again."},403);}
}

export async function readNativeMemberDemoDocuments(_:unknown,argsInput:{input:unknown},context:{request:Request}){
 const sdk=await current(context.request);const id=memberDemoDocumentsInputSchema.parse(argsInput.input).documentId;
 const out=await queryMemberDemoDocuments("read",[...args(sdk),id]);await unchanged(context.request,sdk);
 if(out.schema!=="crays.clubs.member-demo-documents.v1"||out.accountId!==sdk.expectedAccountId||out.testOnly!==true)throw Error("DOCUMENT_READ_SCOPE_INVALID");
 memberDemoDocumentsReadSchema.parse(out);
 return {schema:out.schema,payloadJson:JSON.stringify(out)};
}
