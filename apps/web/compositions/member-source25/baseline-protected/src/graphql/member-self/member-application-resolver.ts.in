import "server-only";
import {createHash} from "node:crypto";
import {z} from "zod";
import {GraphQLError} from "graphql";
import {memberSelfPorts} from "./member-self-runtime-ports";
import {queryMemberApplication} from "@/db/core-member-application-runtime";
import {memberApplicationCommandSchema,memberApplicationReadSchema,memberApplicationOutcomeSchema} from "@/lib/clubs/member-application-contract";
const own="__CRAYS_PROTECTED_MEMBER_TEST_ACCOUNT_ID__";
type Sdk=NonNullable<Awaited<ReturnType<typeof memberSelfPorts.resolveCurrentSdk>>>;
async function current(request:Request){const sdk=await memberSelfPorts.resolveCurrentSdk(request);if(!sdk||sdk.expectedAccountId!==own)throw new GraphQLError("Please sign in to your own account.",{extensions:{code:"FORBIDDEN"}});return sdk;}
const args=(s:Sdk)=>[s.issuer,s.subject,createHash("sha256").update(s.serverConfiguredClientId).digest("hex")];
async function unchanged(request:Request,s:Sdk){const after=await current(request);if(after.issuer!==s.issuer||after.subject!==s.subject||after.serverConfiguredClientId!==s.serverConfiguredClientId||after.expectedAccountId!==s.expectedAccountId)throw new GraphQLError("Your sign-in changed. Check the saved application before trying again.",{extensions:{code:"FORBIDDEN"}});}
async function mapped<T>(run:()=>Promise<T>):Promise<T>{try{return await run();}catch(error){if(error instanceof GraphQLError)throw error;const code=typeof error==="object"&&error!==null&&"code" in error?String(error.code):"";const constraint=typeof error==="object"&&error!==null&&"constraint" in error?String(error.constraint):"";if(code==="23503"&&constraint==="clubs_member_membership_applications_interest_property_id_fkey")throw new GraphQLError("Your property interest is not connected yet. Your application has not been saved.",{extensions:{code:"APPLICATION_PROPERTY_MAPPING_REQUIRED"}});throw new GraphQLError("We couldn’t safely complete this application request.",{extensions:{code:code==="42501"?"FORBIDDEN":code==="40001"?"CONFLICT":code==="22023"?"BAD_USER_INPUT":"UNAVAILABLE"}});}}
export async function readNativeMemberApplication(_:unknown,{input}:{input:unknown},{request}:{request:Request}){if(!z.object({contractVersion:z.literal("1.0.0")}).strict().safeParse(input).success)throw new GraphQLError("Check the application request.",{extensions:{code:"BAD_USER_INPUT"}});return mapped(async()=>{const sdk=await current(request);const out=memberApplicationReadSchema.parse(await queryMemberApplication("read",args(sdk),()=>unchanged(request,sdk)));await unchanged(request,sdk);if(out.accountId!==own)throw Error("APPLICATION_SCOPE_DENIED");return {schema:out.schema,payloadJson:JSON.stringify(out)};});}
export async function writeNativeMemberApplication(_:unknown,{input}:{input:unknown},{request}:{request:Request}){const parsed=z.object({requestId:z.string().regex(/^[A-Za-z0-9:_.-]{16,200}$/),commandJson:z.string().min(2).max(3000)}).strict().safeParse(input);if(!parsed.success)throw new GraphQLError("Check the application request.",{extensions:{code:"BAD_USER_INPUT"}});const p=parsed.data;let raw:unknown;try{raw=JSON.parse(p.commandJson);}catch{throw new GraphQLError("Check the application request.",{extensions:{code:"BAD_USER_INPUT"}});}const commandInput=memberApplicationCommandSchema.safeParse(raw);if(!commandInput.success)throw new GraphQLError("Check the application request.",{extensions:{code:"BAD_USER_INPUT"}});const command=commandInput.data;if(command.idempotencyKey!==p.requestId||request.headers.get("idempotency-key")!==p.requestId)throw new GraphQLError("The original request key must match.",{extensions:{code:"FORBIDDEN"}});return mapped(async()=>{const sdk=await current(request);await unchanged(request,sdk);const out=memberApplicationOutcomeSchema.parse(await queryMemberApplication("command",[...args(sdk),JSON.stringify(command)],()=>unchanged(request,sdk)));try{await unchanged(request,sdk);}catch{throw new GraphQLError("Your sign-in changed after the request. Check its original saved status before continuing.",{extensions:{code:"UNAVAILABLE"}});}if(out.accountId!==own||out.idempotencyKey!==p.requestId||out.commandType!==command.type)throw Error("APPLICATION_ACKNOWLEDGEMENT_MISMATCH");return {schema:out.schema,payloadJson:JSON.stringify(out)};});}
