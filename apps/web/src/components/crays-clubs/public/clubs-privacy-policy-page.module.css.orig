.page {
  background: #fbfaf8;
  color: var(--crays-color-ink);
  font-family: var(--crays-font-avenir-book);
}

.hero {
  background-color: var(--crays-color-navy);
  background-image: url("/brand/crays-privacy-policy-hero-texture.png");
  background-position: center;
  background-size: cover;
  container-type: inline-size;
  color: var(--crays-color-white);
}

.heroInner {
  display: grid;
  grid-template-columns: 47.904% 52.096%;
  margin: 0 auto;
  max-width: var(--crays-content-max-width);
  height: 100dvh;
  min-height: 100svh;
}

.heroTitleBlock,
.heroReadingBlock {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 76px var(--crays-page-gutter);
}

.heroTitleBlock {
  border-right: 1px solid rgb(255 255 255 / 28%);
  padding: 5.3333cqw 5.614cqw 8.1404cqw 7.0659cqw;
}

.heroReadingBlock {
  padding: 6.7368cqw 5.0526cqw;
  padding-left: 5.1497cqw;
}

.eyebrow {
  color: var(--crays-color-red);
  font-family: var(--crays-font-avenir-medium);
  font-size: 1.4035cqw;
  font-weight: 800;
  letter-spacing: var(--crays-type-kicker-tracking);
  line-height: var(--crays-type-kicker-leading);
  margin: 0 0 1.6842cqw;
  text-transform: uppercase;
}

.heroTitleBlock h1 {
  font-family: var(--crays-font-avenir-medium);
  font-size: 5.614cqw;
  font-weight: 800;
  letter-spacing: -0.055em;
  line-height: 0.96;
  margin: 0;
  max-width: 560px;
  white-space: nowrap;
}

.heroReadingBlock {
  align-items: flex-start;
}

.heroIntro {
  font-size: 2.2456cqw;
  letter-spacing: -0.024em;
  line-height: 1.44;
  margin: 0;
  max-width: 36.5269cqw;
}

.heroRule {
  background: var(--crays-color-red);
  display: block;
  height: 2px;
  margin: 2.5263cqw 0 2.1053cqw;
  width: 8.9825cqw;
}

.heroLegalNav {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 10px 0;
}

.heroLegalNav a {
  color: inherit;
  font-family: var(--crays-font-avenir-medium);
  font-size: 1.1228cqw;
  line-height: 1.35;
  text-decoration: none;
  white-space: nowrap;
}

.heroLegalNav a:not(:last-child)::after {
  color: rgb(255 255 255 / 52%);
  content: "|";
  margin: 0 0.9123cqw;
}

.heroLegalNav a[aria-current="page"] {
  color: var(--crays-color-red);
}

.heroLegalNav a:hover,
.heroLegalNav a:focus-visible,
.bottomLegalNav a:hover,
.bottomLegalNav a:focus-visible,
.onThisPage a:hover,
.onThisPage a:focus-visible {
  color: var(--crays-color-red);
}

.onThisPage {
  margin-top: 2.386cqw;
  position: relative;
}

.onThisPage summary {
  align-items: center;
  border: 1px solid rgb(255 255 255 / 42%);
  border-radius: var(--crays-radius-pill);
  cursor: pointer;
  display: inline-flex;
  font-family: var(--crays-font-avenir-medium);
  font-size: 1.0526cqw;
  min-height: 3.0877cqw;
  padding: 0 1.2632cqw;
}

.onThisPage summary::marker {
  color: var(--crays-color-red);
}

.onThisPage nav {
  background: var(--crays-color-white);
  border: 1px solid rgb(0 27 46 / 16%);
  box-sizing: border-box;
  box-shadow: 0 18px 48px rgb(0 27 46 / 18%);
  display: grid;
  left: 0;
  min-width: 0;
  padding: 10px;
  position: absolute;
  top: calc(100% + 10px);
  width: min(330px, calc(100vw - 40px));
  z-index: 5;
}

.onThisPage a {
  align-items: baseline;
  color: var(--crays-color-ink);
  display: grid;
  font-family: var(--crays-font-avenir-medium);
  font-size: 13px;
  gap: 14px;
  grid-template-columns: 24px 1fr;
  padding: 10px 12px;
  text-decoration: none;
}

.onThisPage a span {
  color: var(--crays-color-red);
  font-size: 11px;
}

.readingRows {
  container-type: inline-size;
  margin: 0 auto;
  max-width: none;
  padding: 0 0 2.5263vw;
}

.readingRow {
  display: grid;
  grid-template-columns: 8.503% minmax(0, 1fr);
  scroll-margin-top: 92px;
}

.markerCell {
  grid-column: 1;
  min-height: 100%;
  position: relative;
}

.markerCell::before {
  border-left: 1px solid rgb(11 95 199 / 52%);
  bottom: 0;
  content: "";
  left: 52.113%;
  position: absolute;
  top: 0;
}

.markerCellStart::before {
  top: 4.0702cqw;
}

.markerCellEnd::before {
  bottom: calc(100% - 4cqw);
}

.marker {
  background: #fbfaf8;
  border: 1px solid var(--crays-color-blue);
  border-radius: 50%;
  height: 0.7719cqw;
  left: 52.113%;
  position: absolute;
  top: 3.5789cqw;
  transform: translateX(-50%);
  width: 0.7719cqw;
  z-index: 1;
}

.markerActive {
  background: var(--crays-color-red);
  border-color: var(--crays-color-red);
  height: 0.8421cqw;
  width: 0.8421cqw;
}

.contactRow .marker {
  top: 3.6491cqw;
}

.readingRow:nth-child(2) .marker {
  top: 4.8421cqw;
}

.contactPanel,
.sectionPanel {
  grid-column: 2;
  margin-left: 0;
}

.contactPanel {
  background: #e8eff7;
  box-sizing: border-box;
  display: grid;
  gap: 7.766%;
  grid-template-columns: 15.022% minmax(0, 1fr);
  min-height: 20.8421cqw;
  padding: 3.8596cqw 3.681% 3.2281cqw 4.45%;
}

.contactPanel h2 {
  font-family: var(--crays-font-avenir-medium);
  font-size: 1.614cqw;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
  margin: 0;
}

.contactPanel address {
  font-style: normal;
  max-width: 680px;
}

.contactPanel p {
  font-size: 1.4035cqw;
  line-height: 1.52;
  margin: 0 0 1.2632cqw;
}

.contactPanel a,
.page .inlineLink {
  color: var(--crays-color-red);
  font-family: var(--crays-font-avenir-medium);
  font-weight: 700;
  text-decoration-thickness: 1px;
  text-underline-offset: 4px;
}

.sectionPanel {
  box-sizing: border-box;
  display: grid;
  gap: 10.555%;
  grid-template-columns: 19.608% minmax(0, 1fr);
  max-width: none;
  padding: 3.5789cqw 4.688% 3.5088cqw 4.45%;
  position: relative;
  width: 78.534%;
}

.sectionPanel::after {
  border-top: 1px solid rgb(11 95 199 / 40%);
  bottom: 0;
  content: "";
  left: 5.666%;
  position: absolute;
  right: 0;
}

.readingRow:nth-child(2) .sectionPanel {
  min-height: 24.9123cqw;
  padding-top: 4.7719cqw;
}

.readingRow:nth-child(3) .sectionPanel {
  min-height: 21.6842cqw;
}

.readingRow:nth-child(4) .sectionPanel {
  min-height: 21.3333cqw;
}

.readingRow:nth-child(5) .sectionPanel {
  min-height: 15.7193cqw;
}

.readingRow:nth-child(6) .sectionPanel {
  min-height: 14.8772cqw;
  padding-bottom: 2.9474cqw;
}

.readingRow:nth-child(7) .sectionPanel {
  min-height: 15.9298cqw;
  padding: 3.5789cqw 4.688% 2.5965cqw 4.45%;
}

.sectionMeta {
  align-self: start;
  color: var(--crays-color-red);
  font-family: var(--crays-font-avenir-medium);
  font-weight: 800;
  text-transform: uppercase;
}

.sectionMeta span {
  display: block;
  font-size: 1.193cqw;
  letter-spacing: 0.04em;
  line-height: 1;
  margin-bottom: 1.1228cqw;
}

.sectionMeta h2 {
  font-family: inherit;
  font-size: 1.4035cqw;
  font-weight: inherit;
  letter-spacing: 0.08em;
  line-height: 1.42;
  margin: 0;
}

.sectionBody {
  max-width: 700px;
}

.paragraph,
.listItem {
  font-size: 1.4737cqw;
  letter-spacing: var(--crays-type-body-tracking);
  line-height: 1.42;
}

.paragraph {
  font-style: normal;
  margin: 0;
}

.paragraph + .paragraph {
  margin-top: 1.4035cqw;
}

.listItem + .listItem {
  margin-top: 0.8421cqw;
}

.bottomLegalNav {
  display: grid;
  gap: 0;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-left: 8.503%;
  max-width: none;
  padding: 2.1053cqw 5.666% 0;
  width: 71.856%;
}

.bottomLegalNav a {
  color: var(--crays-color-ink);
  font-family: var(--crays-font-avenir-medium);
  font-size: 1.1228cqw;
  line-height: 1.3;
  padding: 0.8421cqw 1.2632cqw;
  position: relative;
  text-align: center;
  text-decoration: none;
}

.bottomLegalNav a:not(:last-child)::after {
  color: rgb(11 95 199 / 54%);
  content: "|";
  position: absolute;
  right: 0;
}

.bottomLegalNav a[aria-current="page"] {
  color: var(--crays-color-red);
}

.hero a:focus-visible,
.readingRows a:focus-visible,
.onThisPage summary:focus-visible {
  border-radius: 2px;
  outline: none;
  box-shadow: var(--crays-focus-ring);
}

@media (max-width: 1199px) {
  .heroTitleBlock h1 {
    font-size: clamp(54px, 5.614cqw, 80px);
    white-space: normal;
  }

  .eyebrow {
    font-size: clamp(14px, 1.4035cqw, 20px);
  }

  .heroLegalNav a {
    font-size: clamp(13px, 1.1228cqw, 16px);
  }

  .onThisPage summary {
    font-size: clamp(12px, 1.0526cqw, 15px);
    min-height: 42px;
  }

  .sectionMeta h2 {
    font-size: clamp(14px, 1.4035cqw, 20px);
  }

  .sectionMeta span,
  .bottomLegalNav a {
    font-size: clamp(13px, 1.1228cqw, 17px);
  }

  .contactPanel p {
    font-size: clamp(16px, 1.4035cqw, 20px);
    margin-bottom: 16px;
  }

  .paragraph,
  .listItem {
    font-size: clamp(16px, 1.4737cqw, 21px);
  }

  .listItem + .listItem {
    margin-top: 12px;
  }
}

@media (max-width: 760px) {
  .hero {
    height: auto;
    min-height: 0;
  }

  .heroInner {
    display: block;
    min-height: 0;
  }

  .heroTitleBlock,
  .heroReadingBlock {
    padding: 48px 20px;
  }

  .heroTitleBlock {
    border-bottom: 1px solid rgb(255 255 255 / 24%);
    border-right: 0;
    padding-top: calc(48px + var(--crays-header-height));
  }

  .heroTitleBlock h1 {
    font-size: clamp(46px, 14vw, 62px);
    white-space: normal;
  }

  .heroReadingBlock {
    padding-bottom: 54px;
    padding-top: 40px;
  }

  .heroIntro {
    font-size: 20px;
    line-height: 1.46;
  }

  .heroRule {
    margin: 28px 0 24px;
  }

  .heroLegalNav {
    align-items: flex-start;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  .heroLegalNav a {
    border-bottom: 1px solid rgb(255 255 255 / 20%);
    font-size: 13px;
    padding: 10px 0;
    white-space: normal;
  }

  .heroLegalNav a:nth-child(odd) {
    padding-right: 12px;
  }

  .heroLegalNav a:nth-child(even) {
    padding-left: 12px;
  }

  .heroLegalNav a:not(:last-child)::after {
    content: none;
  }

  .onThisPage {
    margin-top: 28px;
  }

  .onThisPage summary {
    font-size: 12px;
    min-height: 44px;
  }

  .readingRows {
    padding: 0 20px 28px;
  }

  .readingRow {
    display: block;
    scroll-margin-top: 74px;
  }

  .markerCell {
    display: none;
  }

  .contactPanel,
  .sectionPanel {
    margin-left: 0;
  }

  .contactPanel {
    display: block;
    margin-inline: -20px;
    min-height: 0;
    padding: 34px 20px 38px;
  }

  .contactPanel h2 {
    font-size: 18px;
    margin-bottom: 24px;
  }

  .contactPanel p {
    font-size: 16px;
  }

  .sectionPanel {
    display: block;
    max-width: none;
    min-height: 0 !important;
    padding: 38px 0 40px;
    width: 100%;
  }

  .sectionPanel::after {
    left: 0;
  }

  .sectionMeta {
    margin-bottom: 24px;
  }

  .sectionMeta span {
    font-size: 13px;
    margin-bottom: 12px;
  }

  .sectionMeta h2 {
    font-size: 15px;
    max-width: 280px;
  }

  .paragraph,
  .listItem {
    font-size: 17px;
    line-height: 1.58;
  }

  .bottomLegalNav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-left: 0;
    max-width: none;
    padding: 20px 0 0;
    width: 100%;
  }

  .bottomLegalNav a {
    border-bottom: 1px solid rgb(11 95 199 / 24%);
    font-size: 13px;
    min-height: 58px;
    padding: 18px 8px;
  }

  .bottomLegalNav a:not(:last-child)::after {
    content: none;
  }
}

@media (max-width: 390px) {
  .heroLegalNav {
    display: block;
  }

  .heroLegalNav a {
    display: block;
    padding-inline: 0 !important;
  }

  .bottomLegalNav {
    display: grid;
  }
}

@media (prefers-reduced-motion: reduce) {
  .readingRow {
    scroll-behavior: auto;
  }
}
