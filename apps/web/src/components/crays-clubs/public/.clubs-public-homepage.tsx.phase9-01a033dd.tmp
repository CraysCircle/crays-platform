function HeroMosaic() {
  const [flipped, setFlipped] = useState<boolean[]>(() => HERO_TILES.map(() => false));

  useEffect(() => {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const forced = window.matchMedia("(forced-colors: active)").matches;
    if (reduced || forced) return;

    let cursor = 0;
    let timer: ReturnType<typeof window.setTimeout>;
    const intervals = [3000, 3400, 3800, 4200, 4400, 3200, 3600, 4000];
    const step = () => {
      setFlipped((current) => current.map((value, index) => (index === cursor ? !value : value)));
      const delay = intervals[cursor % intervals.length];
      cursor = (cursor + 1) % HERO_TILES.length;
      timer = window.setTimeout(step, delay);
    };
    timer = window.setTimeout(step, 5700);
    return () => window.clearTimeout(timer);
  }, []);

  return (
    <div className={styles.heroMosaic} aria-label="Life around the CRAYS community">
      {HERO_TILES.map((tile, index) => (
        <figure className={`${styles.heroTile} ${styles[`tile${index + 1}`]}`} key={tile.first}>
          <img className={`${styles.heroImage} ${flipped[index] ? styles.imageHidden : ""}`} src={tile.first} alt={tile.alt} />
          <img className={`${styles.heroImage} ${styles.secondImage} ${flipped[index] ? styles.imageVisible : ""}`} src={tile.second} alt="" aria-hidden="true" />
        </figure>
      ))}
    </div>
  );
}

function ImageCard({ title, body, image }: { title: string; body: string; image: string }) {
  return (
    <article className={styles.imageCard}>
      <img src={image} alt="" aria-hidden="true" loading="lazy" />
      <div className={styles.cardShade} />
      <div className={styles.cardCopy}>
        <strong>{title}</strong>
        <span>{body}</span>
      </div>
    </article>
  );
}

