      <section className={`${styles.section} ${styles.ambassadorBand}`}>
        <div className={styles.ambassadorImage}>
          <img src="https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=1300&q=84" alt="CRAYS members meeting by the sea" loading="lazy" />
          <div className={styles.cardShade} />
          <h2>Come through<br />someone you trust.</h2>
        </div>
        <div className={styles.ambassadorCopy}>
          <p className={styles.kicker}>You&apos;re in if you&apos;re in</p>
          <p>CRAYS is invitation-led. Ambassadors are creators, founders and community leaders who can prequalify people who add value and uplift the community. The final decision always remains with the CRAYS team.</p>
          <div className={styles.inlineButtons}>
            <Link href={ambassadorHref} className={styles.primaryButton}>Apply through an Ambassador <ArrowRight size={17} /></Link>
            <Link href={applyHref} className={styles.secondaryButton}>Apply directly</Link>
          </div>
        </div>
      </section>

      <section className={`${styles.section} ${styles.faqSection}`}>
        <h2>Frequently asked questions</h2>
        <div className={styles.faqGrid}>
          {FAQS.map(([question, answer]) => (
            <details key={question}>
              <summary>{question}<ChevronDown size={17} /></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <footer className={styles.footer}>
        <section className={styles.footerCta}>
          <p>CLAIM YOUR GLOBAL HOME</p>
          <h2>Meet friends, colleagues and business partners in the new Crays Club world.</h2>
          <Link href={applyHref} className={styles.primaryButton}>Become a member <ArrowRight size={19} /></Link>
        </section>
        <div className={styles.footerMain}>
          <div className={styles.footerBrand}>
            <img src="/brand/crays-logo-dark.svg" alt="CRAYS" />
            <p>An invitation-led community in Forest City, Malaysia. Live, work, learn and build together by the sea.</p>
          </div>
          <div className={styles.footerColumn}><strong>Forest City</strong><Link href={`${root}/forest-city`}>About Forest City</Link><Link href={`${root}/community-life`}>Living in Forest City</Link><Link href={`${root}/hospitality`}>Hospitality</Link><Link href={`${root}/become-a-member`}>Membership</Link></div>
          <div className={styles.footerColumn}><strong>Community</strong><Link href={`${root}/lifestyle`}>Lifestyle</Link><Link href={`${root}/events`}>Events</Link><Link href={`${root}/families`}>Families</Link><Link href={`${root}/teams`}>Teams</Link></div>
          <div className={styles.footerColumn}><strong>Company</strong><Link href={`${root}/about-us`}>About Us</Link><Link href={`${root}/host-company`}>Host Company</Link><Link href={`${root}/portfolio-companies`}>Portfolio Companies</Link><Link href={`${root}/brand-as-a-service`}>Brand as a Service</Link></div>
          <div className={styles.footerColumn}><strong>Connect</strong><Link href={`${root}/contact`}>Contact</Link><Link href={`${root}/ambassadors`}>Ambassadors</Link><Link href={`${root}/conference`}>Conference</Link><a href="https://www.crays.org/" target="_blank" rel="noreferrer">Association</a></div>
        </div>
        <div className={styles.associationLine}><span>CRAYS Business Club Association</span><span>Private Members Club</span></div>
        <div className={styles.legalLine}><span>© 2026 CRAYS. All rights reserved.</span><div><Link href={`${root}/legal/privacy-policy`}>Privacy</Link><Link href={`${root}/legal/terms-and-conditions`}>Terms</Link><Link href={`${root}/legal/data-protection`}>Data protection</Link><Link href={`${root}/legal/imprint`}>Imprint</Link></div></div>
      </footer>
    </main>
  );
}
