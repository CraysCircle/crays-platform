@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

:root {
  --background: #f6f4ef;
  --foreground: #171613;
  --card: #fffdf8;
  --card-foreground: #171613;
  --popover: #fffdf8;
  --popover-foreground: #171613;
  --primary: #185c4c;
  --primary-foreground: #fffdf8;
  --secondary: #ebe7dc;
  --secondary-foreground: #25231e;
  --muted: #ebe7dc;
  --muted-foreground: #706c61;
  --accent-ui: #dfeee9;
  --accent-ui-foreground: #16483d;
  --destructive: #9a4b5f;
  --destructive-foreground: #fff8fa;
  --border: #ded9cc;
  --input: #d6d0c1;
  --ring: #2f7f6a;
  --surface: #fffdf8;
  --surface-strong: #f0eee7;
  --ink-muted: #706c61;
  --line: #ded9cc;
  --rail: #171613;
  --rail-soft: #25231e;
  --accent: #2f7f6a;
  --accent-strong: #185c4c;
  --amber: #b9781d;
  --rose: #9a4b5f;
  --blue: #356f92;
  --success: #2f7f6a;
  --success-foreground: #f7fffb;
  --warning: #b9781d;
  --warning-foreground: #fff9ed;
  --info: #356f92;
  --info-foreground: #f2fbff;
  --radius: 0.5rem;
  --crays-control-height-compact: 2rem;
  --crays-control-height-default: 2.5rem;
  --crays-control-height-comfortable: 2.75rem;
  --crays-rail-width: 4.5rem;
  --crays-tool-nav-width: 15rem;
  --crays-inspector-width: 24rem;
  --crays-table-row-height-compact: 2.5rem;
  --crays-table-row-height-default: 3rem;
  --crays-board-column-width: 19rem;
  --crays-motion-fast: 120ms;
  --crays-motion-default: 180ms;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent-ui);
  --color-accent-foreground: var(--accent-ui-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-success: var(--success);
  --color-success-foreground: var(--success-foreground);
  --color-warning: var(--warning);
  --color-warning-foreground: var(--warning-foreground);
  --color-info: var(--info);
  --color-info-foreground: var(--info-foreground);
  --font-sans: "Geist", "Geist Fallback", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "Geist Mono", "Geist Mono Fallback", ui-monospace, monospace;
  --radius-xs: calc(var(--radius) * 0.5);
  --radius-sm: calc(var(--radius) * 0.75);
  --radius-md: calc(var(--radius) * 0.875);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) * 1.25);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--background);
}

body {
  min-height: 100vh;
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-geist-sans), "Geist", ui-sans-serif, system-ui, sans-serif;
  letter-spacing: 0;
  overflow-x: hidden;
}

button,
input,
select,
textarea {
  font: inherit;
  letter-spacing: 0;
}

:where(button, a, input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: rgba(47, 127, 106, 0.18);
}

.crays-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: rgba(23, 22, 19, 0.25) transparent;
}

.crays-scrollbar::-webkit-scrollbar {
  height: 10px;
  width: 10px;
}

.crays-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(23, 22, 19, 0.22);
  border-radius: 999px;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
