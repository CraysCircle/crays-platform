"use client";
import {useCallback,useEffect,useRef,useState} from "react";
import Image from "../../../integration/browser-image";
import {ArrowRight,CheckCircle2,ChevronDown,Clock3,FileText,Info,RefreshCw} from "lucide-react";
import registry from "../../../graphql/member-self/MEMBER_SELF_OPERATION_REGISTRY.json";
import {MemberGraphQLError,type MemberOperationRegistry} from "../../../lib/clubs/member-graphql-transport";
import type {MemberApplicationRead,MemberApplicationCommand} from "../../../lib/clubs/member-application-contract";
import {restorePendingMemberApplication,persistPendingMemberApplication,clearPendingMemberApplication} from "./member-application-pending-storage";
import {readOwnMemberApplication,executeOwnMemberApplication} from "./member-application-client";
import styles from "./member-complete-workspaces.module.css";
import layout from "./member-native-application-workspace.module.css";
import shared from "./clubs-member-home.module.css";
import {memberDate,memberStatus,type MemberWorkspace} from "./clubs-member-home-model";
const operationRegistry=registry as MemberOperationRegistry;
export function MemberNativeApplicationWorkspace({accountId,locale,onRefresh,onView,membershipFeed}:{accountId:string|null|undefined;locale:string;onRefresh:()=>void;onView:(view:"support"|"documents")=>void;membershipFeed:MemberWorkspace["membership"]}){
 const [storageBlocked,setStorageBlocked]=useState(false);
 const [data,setData]=useState<MemberApplicationRead|null>(null),[loading,setLoading]=useState(true),[loadError,setLoadError]=useState(false),[working,setWorking]=useState(false),[notice,setNotice]=useState(""),[unknown,setUnknown]=useState(false),[marina,setMarina]=useState(false),[confirmWithdraw,setConfirmWithdraw]=useState(false);
 const pending=useRef<MemberApplicationCommand|null>(null),alive=useRef(false),loadController=useRef<AbortController|null>(null);
 const load=useCallback(async()=>{loadController.current?.abort();const controller=new AbortController();loadController.current=controller;setLoading(true);setLoadError(false);try{const value=await readOwnMemberApplication(operationRegistry,fetch,controller.signal);if(alive.current&&!controller.signal.aborted)setData(value);}catch(error){if(alive.current&&!controller.signal.aborted)setLoadError(true);}finally{if(alive.current&&!controller.signal.aborted)setLoading(false);}},[]);
 useEffect(()=>{
  alive.current=true;
  try{
   if(accountId!=="__CRAYS_PROTECTED_MEMBER_TEST_ACCOUNT_ID__")throw Error("Please open your own member account to continue.");
   const saved=restorePendingMemberApplication(accountId,window.sessionStorage);
   if(saved){setMarina(saved.interestPropertyId==="property-clubs-forest-city-marina");pending.current=saved;setUnknown(true);setNotice(`Your original request is still awaiting confirmation: ${saved.idempotencyKey}. Check saved status or retry only this original request.`);}
  }catch(error){setStorageBlocked(true);setNotice(error instanceof Error?error.message:"Your browser couldn't retain the original request reference.");}
  void load();return()=>{alive.current=false;loadController.current?.abort();};
 },[accountId,load]);
 const application=data?.application??null,confirmed=data?.membershipConfirmed===true;
 const canSubmit=Boolean(data&&!confirmed&&(!application||application.status==="withdrawn")),canWithdraw=Boolean(data&&!confirmed&&application&&["submitted","under_review"].includes(application.status));
 async function send(type:MemberApplicationCommand["type"],retry=false){
  if(working||loading||loadError||storageBlocked||!data||accountId!==data.accountId||!retry&&unknown)return;
  const command=retry?pending.current:{contractVersion:"1.0.0" as const,idempotencyKey:`member-application-${crypto.randomUUID()}`,type,expectedVersion:application?.version??null,interestPropertyId:type==="submit_application"&&marina?"property-clubs-forest-city-marina" as const:null};if(!command)return;
  try{persistPendingMemberApplication(accountId,window.sessionStorage,command);}catch(error){setStorageBlocked(true);setNotice(error instanceof Error?error.message:"We couldn't retain your request reference. No application change was sent.");return;}
  pending.current=command;setWorking(true);setNotice("");setConfirmWithdraw(false);
  try{await executeOwnMemberApplication(operationRegistry,fetch,command);if(!alive.current)return;clearPendingMemberApplication(accountId,window.sessionStorage,command.idempotencyKey);pending.current=null;setUnknown(false);setNotice(command.type==="withdraw_application"?"Your application has been withdrawn. Your previous progress stays in your history.":"Your application is safely saved. We'll keep you posted on the next step.");await load();if(alive.current)onRefresh();}
  catch(error){if(!alive.current)return;const mappingRequired=error instanceof MemberGraphQLError&&error.code==="APPLICATION_PROPERTY_MAPPING_REQUIRED";const outcomeUnknown=error instanceof MemberGraphQLError?error.code==="OUTCOME_UNKNOWN":true;setUnknown(outcomeUnknown||mappingRequired);if(!outcomeUnknown&&!mappingRequired){try{clearPendingMemberApplication(accountId,window.sessionStorage,command.idempotencyKey);pending.current=null;}catch{setStorageBlocked(true);}}setNotice(mappingRequired?`${error instanceof Error?error.message:"Your property interest is not connected yet."} Original request: ${command.idempotencyKey}.`:outcomeUnknown?`We couldn't confirm the change. Keep this request reference: ${command.idempotencyKey}. Check your saved status before continuing.`:error instanceof Error?error.message:"We couldn't update your application. Please check your details.");if(!outcomeUnknown)await load();}
  finally{if(alive.current)setWorking(false);}
 }
 const membershipRecord=membershipFeed.kind==="ready"?membershipFeed.data.membership:null;
 const membershipState=membershipRecord?.status??null;
 const membershipIsConfirmed=confirmed&&membershipFeed.kind==="ready"&&membershipFeed.data.authorities.membershipConfirmed===true&&membershipState==="confirmed";
 const membershipNeedsAttention=membershipState==="suspended"||membershipState==="revoked"||membershipState==="expired";
 const membershipStatusPanel=<div className={layout.access}><Info size={23} aria-hidden/><div><strong>Membership confirmation and stay access are separate.</strong><p>Your stay access is confirmed separately from your membership application.</p>{membershipFeed.kind==="ready"?<p>Membership status: {membershipRecord?memberStatus(membershipRecord.status):"not confirmed"}{membershipRecord?.validUntil?<><br/>{membershipIsConfirmed?"Valid until":"Recorded end date"} {memberDate(membershipRecord.validUntil,locale)}</>:null}</p>:<p role="status">{membershipFeed.kind==="loading"?"Checking your membership status…":"We can’t verify your membership status right now."}{membershipFeed.kind!=="loading"?<button type="button" className={shared.textAction} onClick={onRefresh}>Check membership status <RefreshCw size={16} aria-hidden/></button>:null}</p>}</div></div>;
 const chapterPhoto=<div className={layout.photo}><Image src="/member-development/community-welcome.png" alt="A welcome at a CRAYS community gathering" width={1536} height={1024} sizes="(max-width: 760px) 100vw, (max-width: 1100px) 55vw, 42vw" quality={95} loading="eager" decoding="async"/></div>;
 if(loading&&!data)return <div className={layout.chapter}>{chapterPhoto}<section className={layout.summary} role="status"><h2>Finding your application…</h2><p>Your saved status will appear here.</p>{membershipStatusPanel}</section></div>;
 if(loadError)return <div className={layout.chapter}>{chapterPhoto}<section className={layout.summary} role="status"><h2>Your application status is unavailable</h2><p>We couldn't pull up your application just yet. Your saved application hasn't been changed.</p><button type="button" className={shared.smallAction} disabled={loading} onClick={()=>void load()}>Try again <RefreshCw size={16} aria-hidden/></button>{membershipStatusPanel}</section></div>;
 const statusLabel=membershipNeedsAttention?{suspended:"Suspended",revoked:"Revoked",expired:"Expired"}[membershipState]:membershipIsConfirmed?"Confirmed":application?{submitted:"Submitted",under_review:"Under review",approved:"Approved",declined:"Declined",withdrawn:"Withdrawn"}[application.status]:"Not submitted";
 const heading=membershipNeedsAttention?{suspended:"Your membership is suspended.",revoked:"Your membership has been revoked.",expired:"Your membership has expired."}[membershipState]:membershipIsConfirmed?"Your membership, confirmed.":application?{submitted:"Application received.",under_review:"Your application is being reviewed.",approved:"Application approved.",declined:"Application decision recorded.",withdrawn:"Application withdrawn."}[application.status]:"Start your next chapter.";
 const explanation=membershipNeedsAttention?"Message the CRAYS team if you’d like to discuss your membership status. Your saved application progress remains available below.":membershipIsConfirmed?"Your membership has been confirmed by the CRAYS team.":application?{submitted:"Your application is saved and waiting for the CRAYS team’s review.",under_review:"The team is reviewing your application. We’ll share the next step with you.",approved:"Your application was approved. Your membership status is shown separately.",declined:"The CRAYS team has recorded a decision on your application. Message us if you’d like to discuss it.",withdrawn:"Your application has been withdrawn. Your previous progress stays in your history."}[application.status]:"Send your interest to the CRAYS team. Membership and stay access are confirmed separately.";
 const nextStep=unknown?"Check the saved status of your original request before making another change.":storageBlocked?"Your browser cannot safely retain an application request. Check the message below before continuing.":membershipNeedsAttention?"Message the CRAYS team about your membership status.":membershipIsConfirmed?"Plan your next stay or explore what’s happening at CRAYS.":application?{submitted:"Wait for the team’s review. No action is needed right now.",under_review:"We’ll share the next step when the team has an update.",approved:"Check your membership status or message the CRAYS team about the next step.",declined:"Message the CRAYS team if you’d like to discuss the decision.",withdrawn:"You can submit a new application when you’re ready."}[application.status]:"Send your interest to the CRAYS team.";
 return <div className={layout.chapter} aria-busy={working||loading||undefined}>
  {chapterPhoto}
  <section className={layout.summary} aria-labelledby="member-application-summary-heading">
   <p className={layout.eyebrow}>{membershipNeedsAttention||membershipIsConfirmed?"MEMBERSHIP":"APPLICATION"}</p><h2 id="member-application-summary-heading">{heading}</h2>
   <p className={layout.state}><FileText size={18} aria-hidden/>{statusLabel}</p>
   {application?<p className={layout.date}>Submitted {memberDate(application.submittedAt,locale)}</p>:null}
   <p className={layout.explanation}>{explanation}</p>
   <div className={layout.summaryActions}><button type="button" className={shared.primaryAction} onClick={()=>onView("support")}>Message CRAYS <ArrowRight size={18} aria-hidden/></button><button type="button" className={shared.textAction} onClick={()=>onView("documents")}>View documents <ArrowRight size={18} aria-hidden/></button></div>
   {membershipStatusPanel}
  </section>
  <div className={layout.nextStep}><div><Clock3 size={25} aria-hidden/><h3>Your next step</h3></div><p>{nextStep}</p></div>
  {canSubmit?<section className={layout.applicationForm} aria-label="Send your membership interest"><label className={styles.preferenceRow}><input type="checkbox" checked={marina} disabled={working||unknown||loading||storageBlocked} onChange={event=>setMarina(event.target.checked)}/><span>I’m interested in Forest City Marina.</span></label><button type="button" className={shared.primaryAction} disabled={working||loading||unknown||storageBlocked} onClick={()=>void send("submit_application")}>{working?"Saving your application…":application?"Apply again":"Apply for membership"}<ArrowRight size={18} aria-hidden/></button></section>:null}
  <details className={layout.details}>
   <summary><FileText size={25} aria-hidden/><strong>Application details</strong><small>Your original reference, saved progress and options.</small><ChevronDown className={layout.disclosureIcon} size={20} aria-hidden/></summary>
   <div className={layout.detailContent}>
    {application?<><dl className={styles.facts}><div><dt>Application reference</dt><dd className={layout.reference}>{application.applicationId}</dd></div><div><dt>Saved status</dt><dd>{memberStatus(application.status)}</dd></div></dl><ul className={styles.progress} aria-label="Your application progress"><li><CheckCircle2 size={24} aria-hidden/><div><strong>Application submitted</strong><p>{memberDate(application.submittedAt,locale)}</p></div></li>{application.reviewStartedAt?<li><FileText size={24} aria-hidden/><div><strong>Review started</strong><p>{memberDate(application.reviewStartedAt,locale)}</p></div></li>:null}{application.status==="withdrawn"?<li><Info size={24} aria-hidden/><div><strong>Application withdrawn</strong><p>{memberDate(application.updatedAt,locale)}</p></div></li>:null}{application.decidedAt?<li><FileText size={24} aria-hidden/><div><strong>Team decision recorded</strong><p>{memberStatus(application.status)} · {memberDate(application.decidedAt,locale)}</p></div></li>:null}</ul></>:<p>No application has been submitted yet.</p>}
    {data?.history.length?<details><summary className={shared.textAction}>Previous application progress ({data.history.length})</summary><ul className={styles.progress}>{data.history.map(item=><li key={`${item.applicationId}:${item.version}`}><FileText size={22} aria-hidden/><div><strong>{memberStatus(item.status)} · Version {item.version}</strong><p>Submitted {memberDate(item.submittedAt,locale)}</p>{item.reviewStartedAt?<p>Review started {memberDate(item.reviewStartedAt,locale)}</p>:null}<p>Updated {memberDate(item.updatedAt,locale)}</p></div></li>)}</ul></details>:null}
    <div className={layout.actions}>{canWithdraw&&!confirmWithdraw?<button type="button" className={shared.smallAction} disabled={working||loading||unknown||storageBlocked} onClick={()=>setConfirmWithdraw(true)}>Withdraw application</button>:null}<button type="button" className={shared.textAction} disabled={working||loading} onClick={()=>void load()}>Check saved status <RefreshCw size={16} aria-hidden/></button></div>
    {confirmWithdraw?<div role="group" aria-label="Confirm application withdrawal"><p>Ready to withdraw? Your saved application progress will stay in your history.</p><button type="button" className={shared.smallAction} disabled={working||loading||storageBlocked} onClick={()=>void send("withdraw_application")}>Yes, withdraw application</button><button type="button" className={shared.textAction} onClick={()=>setConfirmWithdraw(false)}>Keep my application</button></div>:null}
   </div>
  </details>
  {notice?<div className={layout.feedback} role="status" aria-live="polite"><p>{notice}</p>{unknown&&pending.current?<button type="button" className={shared.smallAction} disabled={working||loading||storageBlocked} onClick={()=>void send(pending.current!.type,true)}>Retry the original request</button>:null}</div>:null}
 </div>;
}
