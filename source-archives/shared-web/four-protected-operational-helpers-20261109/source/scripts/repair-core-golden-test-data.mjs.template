function loadEnv() {
  for (const filename of [".env.local", ".env"]) {
    const filePath = resolve(appRoot, filename);
    if (!existsSync(filePath)) continue;
    for (const line of readFileSync(filePath, "utf8").split(/\r?\n/)) {
      const match = line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)\s*$/);
      if (!match || process.env[match[1]]) continue;
      let value = match[2];
      if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
        value = value.slice(1, -1);
      }
      process.env[match[1]] = value;
    }
  }
}

function poolConfig() {
  const connectionString = process.env.CRAYS_DATABASE_URL;
  if (!connectionString) throw new Error("CRAYS_DATABASE_URL is required.");
  const ssl =
    process.env.CRAYS_DATABASE_SSL === "disable"
      ? undefined
      : { rejectUnauthorized: process.env.CRAYS_DATABASE_SSL_REJECT_UNAUTHORIZED !== "false" };
  return {
    connectionString,
    ssl,
    options: "-c crays.app_role=core_service",
    max: 3,
  };
}

function cleanMarket(title) {
  return String(title || "").replace(/^Prepared Franchise Deal -\s*/i, "").trim();
}

function uniquePropertyName(base, index) {
  if (index === 0) return base;
  const suffixes = ["North Unit", "South Unit", "Annex", "Corner Unit"];
  return `${base} ${suffixes[index % suffixes.length]}`;
}

async function main() {
  loadEnv();
  if (apply && process.env.CONFIRM_CRAYS_GOLDEN_TEST_DATA !== "APPLY_CORE_GOLDEN_TEST_DATA") {
    throw new Error("Set CONFIRM_CRAYS_GOLDEN_TEST_DATA=APPLY_CORE_GOLDEN_TEST_DATA before applying Core golden test data repairs.");
  }

  const pool = new pg.Pool(poolConfig());
  const client = await pool.connect();
  try {
    const rowsResult = await client.query(`
      select
        po.offer_id,
        po.title as offer_title,
        po.market,
        pc.case_id as property_case_id,
        p.property_id,
        p.owner_organization_id,
        d.deal_id,
        bp.package_id as bank_package_id,
        bp.bank_partner_organization_id
      from crays_core.prepared_offers po
      left join crays_core.property_cases pc on pc.case_id = po.property_case_id
      left join crays_core.properties p on p.property_id = pc.property_id
      left join crays_core.deals d on d.prepared_offer_id = po.offer_id
      left join crays_core.bank_packages bp on bp.deal_id = d.deal_id
      where po.offer_id like 'bench_crays_benchmark_%'
      order by po.offer_id
    `);

    const marketCounts = new Map();
    const updates = {
      offers: 0,
      properties: 0,
      ownerOrganizations: 0,
      bankOrganizations: 0,
      accounts: 0,
      partnerOrganizations: 0,
      coreOrganization: 0,
    };
    const preview = [];

    if (apply) await client.query("begin");

    if (apply) {
      const orgResult = await client.query(
        `
          update crays_core.organizations
          set name = 'CRAYS Operating Company',
              organization_type = 'crays',
              status = 'active'
          where organization_id = 'bench_crays_benchmark_20260710_v1_org_crays_core'
             or name = 'CRAYS Benchmark Core'
        `,
      );
      updates.coreOrganization = orgResult.rowCount ?? 0;
    }

    for (const [accountId, displayName, primaryContact] of accountProfiles) {
      if (apply) {
        const result = await client.query(
          `
            update crays_core.crays_accounts
            set display_name = $2,
                primary_contact = $3
            where account_id = $1
          `,
          [accountId, displayName, primaryContact],
        );
        updates.accounts += result.rowCount ?? 0;
      } else {
        updates.accounts += 1;
      }
    }

    for (const [organizationId, name, organizationType, status] of organizationProfiles) {
      if (apply) {
        const result = await client.query(
          `
            update crays_core.organizations
            set name = $2,
                organization_type = $3,
                status = $4
            where organization_id = $1
          `,
          [organizationId, name, organizationType, status],
        );
        updates.partnerOrganizations += result.rowCount ?? 0;
      } else {
        updates.partnerOrganizations += 1;
      }
    }

    for (const row of rowsResult.rows) {
      const market = cleanMarket(row.offer_title);
      const profile = marketProfiles[market];
      if (!profile) {
        throw new Error(`Missing market profile for ${market}`);
      }
      const duplicateIndex = marketCounts.get(market) ?? 0;
      marketCounts.set(market, duplicateIndex + 1);
      const propertyTitle = uniquePropertyName(profile.property, duplicateIndex);
      const offerTitle = `Prepared Franchise Deal - ${profile.city} ${profile.district}`;

      preview.push({
        offerId: row.offer_id,
        offerTitle,
        propertyTitle,
        owner: profile.owner,
        bank: profile.bank,
      });

      if (!apply) {
        updates.offers += 1;
        updates.properties += row.property_id ? 1 : 0;
        updates.ownerOrganizations += row.owner_organization_id ? 1 : 0;
        updates.bankOrganizations += row.bank_partner_organization_id ? 1 : 0;
        continue;
      }

      const offerResult = await client.query(
        `
          update crays_core.prepared_offers
          set title = $2,
              market = $3,
              metadata = coalesce(metadata, '{}'::jsonb) || jsonb_build_object(
                'displayMarket', $3::text,
                'testDataQuality', 'golden_realistic',
                'stakeholderDataReady', true
              )
          where offer_id = $1
        `,
        [row.offer_id, offerTitle, `${profile.city} ${profile.district}`],
      );
      updates.offers += offerResult.rowCount ?? 0;

      if (row.property_id) {
        const propertyResult = await client.query(
          `
            update crays_core.properties
            set title = $2,
                address_summary = $3,
                city = $4,
                country = $5,
                metadata = coalesce(metadata, '{}'::jsonb) || jsonb_build_object(
                  'district', $6::text,
                  'displayAddress', $3::text,
                  'testDataQuality', 'golden_realistic'
                )
            where property_id = $1
          `,
          [row.property_id, propertyTitle, profile.address, profile.city, profile.country, profile.district],
        );
        updates.properties += propertyResult.rowCount ?? 0;
      }

      if (row.owner_organization_id) {
        const ownerResult = await client.query(
          `
            update crays_core.organizations
            set name = $2,
                organization_type = 'landlord',
                status = 'review'
            where organization_id = $1
          `,
          [row.owner_organization_id, profile.owner],
        );
        updates.ownerOrganizations += ownerResult.rowCount ?? 0;
      }

      if (row.bank_partner_organization_id) {
        const bankResult = await client.query(
          `
            update crays_core.organizations
            set name = $2,
                organization_type = 'bank',
                status = 'review'
            where organization_id = $1
          `,
          [row.bank_partner_organization_id, profile.bank],
        );
        updates.bankOrganizations += bankResult.rowCount ?? 0;
      }
    }

    const genericResult = apply
      ? await client.query(`
          select 'generic_owner_organizations' label, count(*)::int value from crays_core.organizations where name ~ '^Owner Organization [0-9]+'
          union all select 'generic_bank_organizations', count(*)::int from crays_core.organizations where name ~ '^Bank Partner [0-9]+'
          union all select 'benchmark_property_titles', count(*)::int from crays_core.properties where title like 'Benchmark Property - %'
          union all select 'generic_candidate_accounts', count(*)::int from crays_core.crays_accounts where display_name ~ '^Franchise Candidate [0-9]+'
          union all select 'numbered_partner_organizations', count(*)::int from crays_core.organizations where name ~ 'Partner [0-9]{3}$'
        `)
      : { rows: [] };

    if (apply) await client.query("commit");

    console.log(
      JSON.stringify(
        {
          mode: apply ? "applied" : "dry_run",
          affected: updates,
          sampledRecords: preview.slice(0, 8),
          remainingGenericCounts: genericResult.rows,
          gates: {
            releasesEnabled: false,
            externalSendingEnabled: false,
            sourceWritesEnabled: false,
            syncApplyEnabled: false,
            targetApplyEnabled: false,
            secretsReturned: false,
          },
        },
        null,
        2,
      ),
    );
  } catch (error) {
    if (apply) await client.query("rollback").catch(() => undefined);
    throw error;
  } finally {
    client.release();
    await pool.end();
  }
}

main().catch((error) => {
  console.error(error instanceof Error ? error.message : error);
  process.exit(1);
});
