async function patchRecord(baseUrl, token, collection, id, body) {
  return crmRequest(baseUrl, `/rest/${collection}/${id}`, {
    method: "PATCH",
    headers: { Authorization: `Bearer ${token}` },
    body: JSON.stringify(body),
  });
}

async function getCollection(baseUrl, token, collection, limit = 200) {
  const payload = await crmRequest(baseUrl, `/rest/${collection}?limit=${limit}&depth=1`, {
    method: "GET",
    headers: { Authorization: `Bearer ${token}` },
  });
  return payload?.data?.[collection] ?? payload?.[collection] ?? [];
}

function firstCreatedId(payload, key) {
  const value = payload?.data?.[key] ?? payload?.[key];
  return value?.id;
}

async function ensureTask(baseUrl, token, taskSpec, existingTasks, existingTargets) {
  const existing = existingTasks.find((task) => task.title === taskSpec.title);
  let taskId = existing?.id;
  const taskPayload = { title: taskSpec.title, status: taskSpec.status, dueAt: taskSpec.dueAt };

  if (taskId) {
    await patchRecord(baseUrl, token, "tasks", taskId, taskPayload);
  } else {
    const created = await crmRequest(baseUrl, "/rest/tasks", {
      method: "POST",
      headers: { Authorization: `Bearer ${token}` },
      body: JSON.stringify(taskPayload),
    });
    taskId = firstCreatedId(created, "createTask");
    if (!taskId) throw new Error(`CRM source did not return an id for task "${taskSpec.title}".`);
    existingTasks.push({ ...taskPayload, id: taskId });
  }

  const targetExists = existingTargets.some(
    (target) => target.taskId === taskId && target.targetOpportunityId === taskSpec.targetOpportunityId,
  );
  if (!targetExists) {
    const createdTarget = await crmRequest(baseUrl, "/rest/taskTargets", {
      method: "POST",
      headers: { Authorization: `Bearer ${token}` },
      body: JSON.stringify({ taskId, targetOpportunityId: taskSpec.targetOpportunityId }),
    });
    const targetId = firstCreatedId(createdTarget, "createTaskTarget");
    existingTargets.push({ id: targetId, taskId, targetOpportunityId: taskSpec.targetOpportunityId });
  }
  return taskId;
}

async function main() {
  loadLocalEnv();
  const baseUrl = safeBaseUrl(requireEnv("CRAYS_CRM_BASE_URL"));
  const emailValue = requireEnv("CRAYS_CRM_EMAIL");
  const password = requireEnv("CRAYS_CRM_PASSWORD");
  const host = new URL(baseUrl).host;

  const summary = {
    apply,
    targetHost: host,
    companies: companies.length,
    people: people.length,
    opportunities: opportunities.length,
    tasks: tasks.length,
    sendsEnabled: false,
    deletesEnabled: false,
  };

  if (!apply) {
    console.log(JSON.stringify({ status: "dry_run", ...summary }, null, 2));
    return;
  }

  const token = await crmAccessToken(baseUrl, emailValue, password);
  for (const company of companies) {
    const { id, ...body } = company;
    await patchRecord(baseUrl, token, "companies", id, body);
  }
  for (const person of people) {
    const { id, ...body } = person;
    await patchRecord(baseUrl, token, "people", id, body);
  }
  for (const opportunity of opportunities) {
    const { id, ...body } = opportunity;
    await patchRecord(baseUrl, token, "opportunities", id, body);
  }

  const existingTasks = await getCollection(baseUrl, token, "tasks");
  const existingTargets = await getCollection(baseUrl, token, "taskTargets");
  const taskIds = [];
  for (const task of tasks) {
    taskIds.push(await ensureTask(baseUrl, token, task, existingTasks, existingTargets));
  }

  console.log(
    JSON.stringify(
      {
        status: "applied",
        ...summary,
        updatedRecords: companies.length + people.length + opportunities.length,
        ensuredTasks: taskIds.length,
      },
      null,
      2,
    ),
  );
}

main().catch((error) => {
  console.error(
    JSON.stringify(
      {
        status: "failed",
        message: error instanceof Error ? error.message : "Unknown CRM source seed failure.",
        httpStatus: error?.status ?? null,
        body: error?.body ?? null,
      },
      null,
      2,
    ),
  );
  process.exit(1);
});
