import { existsSync, readFileSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

const apply = process.argv.includes("--apply");

function loadEnvFile(path) {
  if (!existsSync(path)) return;
  for (const line of readFileSync(path, "utf8").split(/\r?\n/)) {
    const match = line.trim().match(/^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/);
    if (!match) continue;
    const [, key, rawValue] = match;
    if (process.env[key] !== undefined) continue;
    process.env[key] = rawValue.trim().replace(/^['"]|['"]$/g, "");
  }
}

function loadLocalEnv() {
  const cwd = process.cwd();
  const parent = dirname(cwd);
  const grandParent = dirname(parent);
  for (const path of [join(cwd, ".env.local"), join(parent, ".env.local"), join(grandParent, ".env.local"), resolve(".env.local")]) {
    loadEnvFile(path);
  }
}

function requireEnv(key) {
  const value = process.env[key]?.trim();
  if (!value) throw new Error(`${key} is not configured.`);
  return value;
}

function safeBaseUrl(value) {
  const parsed = new URL(value);
  if (parsed.username || parsed.password || parsed.search || parsed.hash) {
    throw new Error("CRM source URL contains unsupported credentials or query data.");
  }
  if (parsed.protocol !== "https:" && !(parsed.protocol === "http:" && ["localhost", "127.0.0.1", "::1"].includes(parsed.hostname))) {
    throw new Error("CRM source URL must be HTTPS or local HTTP.");
  }
  return parsed.toString().replace(/\/$/, "");
}

async function crmRequest(baseUrl, path, init = {}) {
  const target = new URL(path.replace(/^\/+/, ""), `${baseUrl}/`);
  if (target.origin !== new URL(baseUrl).origin) throw new Error("Rejected cross-origin CRM request.");
  const response = await fetch(target, {
    ...init,
    headers: {
      Accept: "application/json",
      ...(init.body ? { "Content-Type": "application/json" } : {}),
      ...(init.headers ?? {}),
    },
  });
  const text = await response.text();
  let body = null;
  try {
    body = text ? JSON.parse(text) : null;
  } catch {
    body = { text: text.slice(0, 500) };
  }
  if (!response.ok) {
    const error = new Error(`CRM source request failed for ${path} with HTTP ${response.status}.`);
    error.status = response.status;
    error.body = body;
    throw error;
  }
  return body;
}

async function graph(baseUrl, query, variables) {
  return crmRequest(baseUrl, "/metadata", {
    method: "POST",
    headers: { Origin: baseUrl },
    body: JSON.stringify({ query, variables }),
  });
}

async function crmAccessToken(baseUrl, email, password) {
  const signIn = await graph(
    baseUrl,
    `mutation SignInForWorkspace($email: String!, $password: String!) {
      signIn(email: $email, password: $password) {
        availableWorkspaces {
          availableWorkspacesForSignIn {
            loginToken
          }
        }
      }
    }`,
    { email, password },
  );
  const loginToken = signIn?.data?.signIn?.availableWorkspaces?.availableWorkspacesForSignIn?.[0]?.loginToken;
  if (!loginToken) throw new Error("CRM source did not return a login token.");

  const auth = await graph(
    baseUrl,
    `mutation getAuthTokensFromLoginToken($loginToken: String!, $origin: String!) {
      getAuthTokensFromLoginToken(loginToken: $loginToken, origin: $origin) {
        tokens {
          accessOrWorkspaceAgnosticToken {
            token
          }
        }
      }
    }`,
    { loginToken, origin: baseUrl },
  );
  const token = auth?.data?.getAuthTokensFromLoginToken?.tokens?.accessOrWorkspaceAgnosticToken?.token;
  if (!token) throw new Error("CRM source did not return an access token.");
  return token;
}

function phone(number) {
  return {
    primaryPhoneNumber: number,
    primaryPhoneCountryCode: "DE",
    primaryPhoneCallingCode: "+49",
    additionalPhones: [],
  };
}

function domain(primaryLinkUrl) {
  const label = primaryLinkUrl.replace(/^https?:\/\//, "").replace(/\/$/, "");
  return { primaryLinkLabel: label, primaryLinkUrl, secondaryLinks: [] };
}

function address(addressStreet1, addressCity, addressPostcode, addressState = "") {
  return {
    addressStreet1,
    addressStreet2: "",
    addressCity,
    addressPostcode,
    addressState,
    addressCountry: "Germany",
    addressLat: null,
    addressLng: null,
  };
}

function euros(amount) {
  return { amountMicros: Math.round(amount * 1_000_000), currencyCode: "EUR" };
}

function email(primaryEmail) {
  return { primaryEmail, additionalEmails: [] };
}

