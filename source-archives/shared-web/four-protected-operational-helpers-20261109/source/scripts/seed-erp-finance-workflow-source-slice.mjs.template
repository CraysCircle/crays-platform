function record(family, label, options) {
  const externalId = options.externalId ?? `erp_finance_${slug(family)}_${digest(label, 10)}`;
  return {
    family,
    label,
    externalId,
    craysEntityType: options.craysEntityType,
    craysEntityId: options.craysEntityId ?? `erp_finance_${slug(label)}_${digest([family, label], 8)}`,
    syncStatus: options.syncStatus ?? "synced",
    owner: options.owner,
    role: options.role ?? "finance",
    status: options.status,
    dueDate: options.dueDate,
    priority: options.priority ?? "medium",
    fields: options.fields ?? {},
  };
}

